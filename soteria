def main() -> int:
    # allow `soteria run ... -- cmd` (argparse REMAINDER keeps the '--')
    argv = sys.argv[1:]
    if "run" in argv:
        i = argv.index("run")
        if "--" in argv[i:]:
            j = argv.index("--", i)
            argv = argv[:j] + argv[j + 1:]
    # _broker keeps its `--` so argparse ends option parsing; cmd_broker strips it.
    args = build_parser().parse_args(argv)
    if getattr(args, "cmd", None) == ["--"]:
        args.cmd = []
    # split comma credential/allow-domain values
    for k in ("credential", "allow_domain"):
        pass
    flat = []
    for c in args.credential if hasattr(args, "credential") else []:
        flat += [x.strip() for x in c.split(",") if x.strip()]
    if hasattr(args, "credential"):
        args.credential = flat
    return args.fn(args)


if __name__ == "__main__":
    raise SystemExit(main())
