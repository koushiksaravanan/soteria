            out16 = _b64t.b64decode(r16b.get("stdout_b64", "")).decode()
        except Exception:
            out16 = ""
        check("daemon allows echo", r16b.get("exit") == 0 and "daemon-hi" in out16,
              f"exit={r16b.get('exit')} out={out16[:120]!r} err={r16b.get('stderr_b64','')[:60]!r}")
        r16c = daemon_handle_request({"tool": "echo", "argv": ["x"], "cwd": "/tmp", "caller": "session", "depth": 0}, dctx2, {})
        check("daemon confines cwd", r16c.get("exit") == 3)
        r16d = daemon_handle_request({"tool": "echo", "argv": ["x"], "cwd": str(proj), "caller": "session", "depth": 9}, dctx2, {})
        check("daemon depth cap", r16d.get("exit") == 3)
        check("broker forward fallback", broker_forward(str(Path(tmp) / "no-such.sock"), "echo", ["hi"]) is None)

        # P18: resource limits — parse_size unit + daemon-side enforcement
        check("parse_size bytes/bare", parse_size("1048576") == 1048576 and parse_size(1024) == 1024)
        check("parse_size suffixes",
              parse_size("512M") == 512 * 1024 ** 2 and parse_size("2g") == 2 * 1024 ** 3
              and parse_size("1K") == 1024 and parse_size("512MB") == 512 * 1024 ** 2)
        check("parse_size zero/unset", parse_size("0") is None and parse_size(None) is None and parse_size("") is None)
        _psz_ok = True
        try:
            parse_size("bogus")
            _psz_ok = False
        except ValueError:
            pass
        try:
            parse_size("1.5G")
            _psz_ok = False
        except ValueError:
            pass
        check("parse_size rejects garbage", _psz_ok)
        import time as _t18
        dctx_lim = dict(dctx2, memory_bytes=8 * 1024 * 1024, max_processes=64, tool_timeout=10)
        _t0 = _t18.monotonic()
        r18 = daemon_handle_request({"tool": "echo", "argv": ["hi"], "cwd": str(proj), "caller": "session", "depth": 0}, dctx_lim, {})
        _dt = _t18.monotonic() - _t0
        # 8M AS fits /bin/echo on Linux (no dyld bloat) and is skipped on
        # macOS -> tiny tools must still succeed everywhere, fast, no hang.
        check("tiny mem cap does not break tiny tools", r18.get("exit") == 0 and _dt < 10,
              f"exit={r18.get('exit')} dt={_dt:.1f}s")
        # Real enforcement proof: a 64M alloc under an 8M cap must die on
        # Linux (mmap fails); macOS skips AS so it succeeds (best-effort).
        py18b = shutil.which("python3")
        if py18b is None:
            print("[SKIP] mem-cap enforcement probe — no python3 on PATH")
        else:
            _t0 = _t18.monotonic()
            r18b = daemon_handle_request(
                {"tool": os.path.basename(py18b), "argv": ["-c", "bytearray(64*1024*1024)"],
                 "cwd": str(proj), "caller": "session", "depth": 0},
                dict(dctx_lim, base_path=os.path.dirname(py18b) + ":/bin:/usr/bin"), {})
            _dt = _t18.monotonic() - _t0
            if sys.platform == "darwin":
                check("darwin mem cap best-effort documented", r18b.get("exit") == 0,
                      f"exit={r18b.get('exit')}")
            else:
                check("linux mem cap kills big alloc", r18b.get("exit") != 0 and _dt < 10,
                      f"exit={r18b.get('exit')} dt={_dt:.1f}s")
        check("cgroup unavailable skips gracefully",
              _cgroup_join_child("soteria-test-nonexistent", None, None) is False)
        p = _run_cli(home, "run", "--allow", str(proj), "--no-rollback",
                     "--memory", "512M", "--max-processes", "64",
                     "--", "/bin/echo", "limited-hi")
        check("run --memory/--max-processes accepted", p.returncode == 0 and "limited-hi" in p.stdout,
              f"rc={p.returncode} err={p.stderr.strip()[-200:]!r}")
        p = _run_cli(home, "run", "--allow", str(proj), "--no-rollback",
                     "--memory", "bogus-size", "--", "/bin/echo", "hi")
        check("run --memory garbage fails closed", p.returncode == 2)
        # RLIMIT_CPU backstop kills spin-loops fast (hermetic, bounded ~1-2s)
        cands18 = [shutil.which("python3"), getattr(sys, "_base_executable", None)]
        py18 = next((c for c in cands18 if c and os.path.basename(c).startswith("python")), None)
        if py18 is None:
            print("[SKIP] cpu-limit test — no system python3")
        else:
            _t0 = _t18.monotonic()
            try:
                _p = subprocess.run([py18, "-c", "while True: pass"], capture_output=True, timeout=15,
                                    preexec_fn=_make_limits_preexec(None, None, 1))
                _cpu_ok, _cpu_dt = _p.returncode != 0, _t18.monotonic() - _t0
            except subprocess.TimeoutExpired:
                _cpu_ok, _cpu_dt = False, _t18.monotonic() - _t0
            check("cpu backstop kills spin fast", _cpu_ok and _cpu_dt < 12,
                  f"dt={_cpu_dt:.1f}s")

        # P18: ghost sessions — job roundtrip, liveness, stop, detached CLI
        try:
            SESSIONS.mkdir(parents=True, exist_ok=True)
            _g1 = session_create(["/bin/echo", "hi"], proj, None)
            _g1r = session_read(_g1["id"])
            check("sessions roundtrip",
                  _g1r is not None and _g1r.get("cmd") == ["/bin/echo", "hi"]
                  and _g1r.get("status") == "running"
                  and Path(_g1r.get("spool", "")).is_file())
            _g1["status"] = "exited"
            _g1["exit_code"] = 0
            _session_write(_g1)
            check("sessions unknown id", session_read("no-such-session-xyz") is None)
        except Exception as e:
            check("sessions roundtrip", False, str(e)[:200])
        try:
            _alive, _ = session_alive({"id": "g2", "pid": os.getpid(), "status": "running", "exit_code": None})
            _dead, _ = session_alive({"id": "g2d", "pid": 2**30, "status": "running", "exit_code": None})
            check("sessions liveness self/dead", bool(_alive) and not bool(_dead))
            _ok, _ = _session_pid_valid({"id": "no-such-session-xyz", "pid": 2**30})
            check("sessions pid-validate refuses unknown", not _ok)
        except Exception as e:
            check("sessions liveness self/dead", False, str(e)[:200])
        try:
            _sl = subprocess.Popen(["/bin/sleep", "30"])
            _sj = session_create(["/bin/sleep", "30"], proj, None)
            _sj["pid"] = _sl.pid
            _session_write(_sj)
            _rc, _msg = session_stop(_sj["id"], grace=0.5)
            try:
                _sl.wait(timeout=5)
                _gone = _sl.returncode is not None
            except subprocess.TimeoutExpired:
                _gone = False
                _sl.kill()
            check("sessions stop kills sleep", _rc == 0 and _gone, _msg[:200])
            _rc2, _ = session_stop(_sj["id"], grace=0.2)
            check("sessions double-stop clean", _rc2 == 0)
        except Exception as e:
            check("sessions stop kills sleep", False, str(e)[:200])
        try:
            p = _run_cli(home, "run", "--allow", str(proj), "--no-rollback",
                         "--detached", "--", "/bin/echo", "ghost-hi")
            _gid = None
            for line in (p.stdout + p.stderr).splitlines():
                if line.startswith("detached "):
