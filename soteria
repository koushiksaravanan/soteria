                _deadline = time.time() + 10
                while time.time() < _deadline:
                    _j = session_read(_gid)
                    if _j is not None and _j.get("status") == "exited" and _j.get("exit_code") == 0:
                        try:
                            _spool_ok = "ghost-hi" in Path(str(_j.get("spool"))).read_text(errors="replace")
                        except OSError:
                            _spool_ok = False
                        break
                    time.sleep(0.05)
            check("sessions detached echo spools", _ok4 and _spool_ok,
                  f"rc={p.returncode} id={_gid} out={(p.stdout + p.stderr).strip()[-200:]!r}")
            if _gid:
                q = _run_cli(home, "sessions")
                check("sessions lists detached", q.returncode == 0 and _gid in q.stdout,
                      q.stdout.strip()[-200:])
                a = _run_cli(home, "attach", _gid)
                check("sessions attach dumps", a.returncode == 0 and "ghost-hi" in a.stdout,
                      a.stdout.strip()[-200:])
                s = _run_cli(home, "stop", _gid)
                check("sessions stop exited clean", s.returncode == 0,
                      (s.stdout + s.stderr).strip()[-200:])
            else:
                check("sessions lists detached", False, "no gid from detached run")
        except Exception as e:
            check("sessions detached echo spools", False, str(e)[:200])
        try:
            _before = {j["id"] for j in session_list()}
            p = _run_cli(home, "run", "--allow", str(proj), "--no-rollback",
                         "--detached", "--", "rm", "-rf", "x")
            _after = {j["id"] for j in session_list()}
            check("sessions detached deny rc3 leaks no job",
                  p.returncode == 3 and _after == _before,
                  f"rc={p.returncode}")
            p = _run_cli(home, "run", "--allow", str(proj), "--no-rollback",
                         "--detached", "--", "git", "push", "origin", "main")
            check("sessions detached ask without channel refuses", p.returncode == 3,
                  f"rc={p.returncode} out={(p.stdout + p.stderr).strip()[-200:]!r}")
        except Exception as e:
            check("sessions detached deny rc3 leaks no job", False, str(e)[:200])

        # P19: harness-state lockdown — agents can't self-auth from host OAuth state
        try:
            _cc = load_profile("claude-code")
            _cc_fs = _cc.get("filesystem", {}) or {}
            check("claude-code denies harness state",
                  "deny_harness_state" in ((_cc.get("groups", {}) or {}).get("include", []) or [])
                  and "~/.claude" not in (_cc_fs.get("allow", []) or [])
                  and "~/.claude.json" not in (_cc_fs.get("allow_files", []) or []))
        except Exception as e:
            check("claude-code denies harness state", False, str(e)[:200])
        p = _run_cli(home, "why", "--path", str(Path.home() / ".claude.json"), "--profile", "claude-code")
        check("why denies claude state", "DENY" in p.stdout,
              p.stdout.strip()[-200:])
        p = _run_cli(home, "run", "--allow", str(proj), "--no-rollback",
                     "--", "/bin/cat", str(Path.home() / ".claude.json"))
        check("claude state read denied", p.returncode == 3,
              f"rc={p.returncode} out={(p.stdout + p.stderr).strip()[-200:]!r}")
        p = _run_cli(home, "run", "--allow", str(proj), "--no-rollback",
                     "--", "/bin/cat", str(Path.home() / ".kube" / "config"))
        check("kubeconfig read denied", p.returncode == 3,
              f"rc={p.returncode} out={(p.stdout + p.stderr).strip()[-200:]!r}")
        # setup refreshes stale shipped presets (with backup), leaves custom files
        try:
            _cfg19 = Path(tmp) / "cfg19"
            (_cfg19 / "profiles").mkdir(parents=True, exist_ok=True)
            (_cfg19 / "profiles" / "developer.json").write_text('{"stale": true}')
            (_cfg19 / "profiles" / "my-custom.json").write_text('{"custom": true}')
            p = _run_cli(home, "setup", env_extra={"SOTERIA_CONFIG": str(_cfg19)})
            _ref = json.loads((_cfg19 / "profiles" / "developer.json").read_text())
            _baks = list((_cfg19 / "profiles").glob("developer.bak-*"))
            check("setup refreshes stale preset",
                  p.returncode == 0 and _ref.get("stale") is None
                  and len(_baks) == 1 and not _baks[0].suffix == ".json"
                  and (_cfg19 / "profiles" / "my-custom.json").read_text() == '{"custom": true}',
                  (p.stdout + p.stderr).strip()[-200:])
        except Exception as e:
            check("setup refreshes stale preset", False, str(e)[:200])
        p = _run_cli(home, "profile", "list")
        check("profile list hides backups",
              p.returncode == 0 and ".bak-" not in p.stdout,
              p.stdout.strip()[-200:])

    audit({"kind": "self_test", "level": "INFO",
           "summary": f"{sum(1 for _, ok, _ in results if ok)}/{len(results)} passed"})
    failed = [n for n, ok, _ in results if not ok]
    print(f"\n{len(results) - len(failed)}/{len(results)} passed" + (f" — failed: {', '.join(failed)}" if failed else ""))
    return 0 if not failed else 1


def cmd_profile(args) -> int:
    action = getattr(args, "profile_action", "list")
    user_dir = _config_dir() / "profiles"
    if action == "list":
        print("presets: " + ", ".join(sorted(PROFILE_PRESETS)))
        for label, d in (("user", user_dir), ("bundled", _resource_dir("profiles"))):
            if d.exists():
                for p in sorted(d.glob("*.json")):
                    if ".bak-" in p.stem:
                        continue  # setup refresh backups are not profiles
                    print(f"{label}: {p.stem} ({p})")
        return 0
    if action == "init":
        name = args.name or "my-agent"
        base = args.extends or "developer"
        dest = Path(args.out or (user_dir / f"{name}.json"))
        try:
            parent = load_profile(base)
        except Exception as e:
            print(f"error: cannot extend {base!r}: {e}", file=sys.stderr)
            return 2
        skel = {
            "meta": {"name": name, "version": "1.0.0", "description": f"extends {base}"},
            "extends": base,
            "filesystem": {"allow": [], "read": [], "write": [], "deny": [], "bypass_protection": []},
            "network": {"network_profile": parent.get("network", {}).get("network_profile", "developer")},
        }
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(json.dumps(skel, indent=2))
        print(f"wrote {dest} — validate with: ./soteria profile validate --file {dest}")
        return 0
    if action == "validate":
        target = args.file or args.name
        if not target:
            print("error: profile validate needs --file PATH or NAME", file=sys.stderr)
            return 2
        try:
            p = load_profile(target) if not Path(str(target)).exists() else json.loads(Path(str(target)).read_text())
        except Exception as e:
            print(f"INVALID: {e}", file=sys.stderr)
            return 1
        errs = validate_profile(p)
        if errs:
            print("INVALID:")
            for e in errs:
                print(f"  - {e}")
            return 1
        print(f"VALID: {p.get('meta', {}).get('name', target)}")
        return 0
    if action == "show":
        try:
            p = load_profile(args.name or args.file)
        except Exception as e:
            print(f"error: {e}", file=sys.stderr)
            return 2
        print(json.dumps(p, indent=2))
        return 0
    if action == "diff":
        try:
            a = load_profile(args.a)
            b = load_profile(args.b)
        except Exception as e:
            print(f"error: {e}", file=sys.stderr)
            return 2
        import difflib as _dl
        al = json.dumps(a, indent=2, sort_keys=True).splitlines()
        bl = json.dumps(b, indent=2, sort_keys=True).splitlines()
        for line in _dl.unified_diff(al, bl, f"a/{args.a}", f"b/{args.b}", lineterm=""):
            print(line)
        return 0
    print(f"error: unknown profile action {action!r}", file=sys.stderr)
    return 2


def cmd_setup(args) -> int:
    checks = [
        ("python", sys.version.split()[0], True),
        ("sandbox-exec", shutil.which("sandbox-exec") or "missing",
         bool(shutil.which("sandbox-exec")) if sys.platform == "darwin" else True),
        ("docker", shutil.which("docker") or "missing", True),
        ("nono", shutil.which("nono") or "missing (brew install nono for --backend nono)", True),
    ]
    if sys.platform.startswith("linux"):
        info = linux_landlock_info()
        checks.append(("landlock", info["summary"], True))
        if not shutil.which("nono"):
            print("soteria: Linux has no native Landlock yet — kernel isolation needs "
                  "`brew install nono` + `--backend nono` (or --backend docker)", file=sys.stderr)
    ok = True
    for name, val, required in checks:
        print(f"{name}: {val}")
    if getattr(args, "check_only", False):
        return 0
    cfg = _config_dir()
    cfg.mkdir(parents=True, exist_ok=True)
    (cfg / "profiles").mkdir(parents=True, exist_ok=True)
    # P5/P6: install shipped presets to user config on first setup (easy deploy;
    # frozen-aware: PyInstaller _MEIPASS when bundled, else repo tree).
    # Shipped preset names are soteria-owned: when the bundled copy moves
    # (e.g. a security tightening), refresh the user copy with a backup.
    # Custom files (any other name) are never touched.
    try:
        repo_profiles = _resource_dir("profiles")
        if repo_profiles.is_dir():
            for src in sorted(repo_profiles.glob("*.json")):
                dest = cfg / "profiles" / src.name
                try:
                    new = src.read_bytes()
                except OSError:
                    continue
                if not dest.exists():
                    try:
                        dest.write_bytes(new)
                    except OSError as e:
                        print(f"warn: profile install skipped: {e}", file=sys.stderr)
                        continue
                    print(f"installed profile {src.name}")
                elif src.stem in PROFILE_PRESETS:
                    try:
                        old = dest.read_bytes()
                    except OSError:
                        continue
                    if old != new:
                        bak = cfg / "profiles" / f"{src.stem}.bak-{time.strftime('%Y%m%d-%H%M%S')}"
                        try:
                            shutil.copy2(dest, bak)
                            dest.write_bytes(new)
                        except OSError as e:
                            print(f"warn: profile refresh skipped: {e}", file=sys.stderr)
                            continue
                        print(f"refreshed profile {src.name} (previous copy -> {bak.name})")
    except OSError as e:
        print(f"warn: profile install skipped: {e}", file=sys.stderr)
    print(f"config dir ready: {cfg}")
    return 0


def cmd_why(args) -> int:
    """Explain allow/deny without executing (nono why lite)."""
    try:
        profile = load_profile(getattr(args, "profile", "developer") or "developer")
    except Exception as e:
        print(f"error: {e}", file=sys.stderr)
        return 2
    if getattr(args, "path", None):
        q = os.path.realpath(os.path.expanduser(args.path))
        op = getattr(args, "op", "read") or "read"
        fs = profile.get("filesystem", {})
        denies = [expand_profile_vars(d) for d in (fs.get("deny", []) or [])]
        # group denies
        for g in (profile.get("groups", {}) or {}).get("include", []) or []:
            denies += [expand_profile_vars(d) for d in GROUP_DEFS.get(g, {}).get("deny", [])]
        denies_r = [os.path.realpath(os.path.expanduser(d)) for d in denies]
        hit = next((d for d in denies_r if q == d or q.startswith(d.rstrip("/") + "/")), None)
        if hit:
            print(f"DENY {op} {args.path} (matched deny {hit})")
            return 0
        print(f"ALLOW {op} {args.path} (no deny match; writes still boxed to --allow in kernel mode)")
        return 0
    if getattr(args, "host", None):
        host = args.host.lower()
        net = profile.get("network", {})
        deny = [d.lower() for d in (net.get("deny_domain", []) or [])]
        allow = [d.lower() for d in (net.get("allow_domain", []) or [])]
        prof = (net.get("network_profile") or "").lower()
        if any(_host_match(host, d) for d in deny if d):
            print(f"DENY CONNECT {args.host} (deny_domain)")
            return 0
        if is_always_denied_host(host):
            print(f"DENY CONNECT {args.host} (always-denied metadata/link-local)")
            return 0
        groups: list[str] = []
        for g in NETWORK_PROFILES.get(prof, []):
            groups += NETWORK_GROUPS.get(g, [])
        if any(_host_match(host, a) for a in (allow + groups)):
            print(f"ALLOW CONNECT {args.host} (profile {prof or 'none'} groups/allow-list)")
            return 0
        print(f"DENY CONNECT {args.host} (not in profile {prof or 'none'} groups/allow-list)")
        return 0
    if getattr(args, "command", None):
        tp = tool_verdict(list(args.command), profile.get("command_policies"))
        if tp is not None:
            v, reason = tp
            print(f"{v.upper()}: {' '.join(args.command)} — {reason} (tool policy)")
            return 0
        v, reason = argv_verdict(list(args.command), set(DEFAULT_DENY_CMDS), "escalations")
        print(f"{v.upper()}: {' '.join(args.command)} — {reason}")
        return 0
    print("usage: soteria why --path P [--op read|write] | --host H | --command CMD...", file=sys.stderr)
    return 2


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog="soteria", description="soteria — supervised agent runs + audit + undo")
    sub = ap.add_subparsers(dest="c", required=True)
    l = sub.add_parser("launch", help="interactive wizard (or --ui for browser)")
    l.add_argument("--ui", action="store_true", help="open visual launcher + monitor in browser")
    l.add_argument("--port", type=int, default=0)
    l.set_defaults(fn=cmd_launch)
    lp = sub.add_parser("launch-ui", help="alias for launch --ui")
    lp.add_argument("--port", type=int, default=0)
    lp.set_defaults(fn=lambda a: cmd_launch_ui(a.port))
    r = sub.add_parser("run", help="run a command boxed")
    r.add_argument("--profile", default="developer")
    r.add_argument("--allow", default=".")
    r.add_argument("--read", action="append", default=[], help="extra read-only dir (repeatable)")
    r.add_argument("--write", action="append", default=[], help="extra write-only dir (repeatable)")
    r.add_argument("--allow-file", action="append", default=[], help="extra read+write file (repeatable)")
    r.add_argument("--read-file", action="append", default=[], help="extra read-only file (repeatable)")
    r.add_argument("--write-file", action="append", default=[], help="extra write-only file (repeatable)")
    r.add_argument("--bypass-protection", action="append", default=[], help="hole through deny group (needs matching grant)")
    r.add_argument("--network-profile", default=None,
                   help="named domain group set (default: from profile, else developer)")
    r.add_argument("--proxy-port", type=int, default=0,
                   help="fixed localhost proxy port (default: OS-assigned ephemeral)")
    r.add_argument("--credential", action="append", default=[])
    r.add_argument("--allow-domain", action="append", default=[])
    r.add_argument("--deny-domain", action="append", default=[], help="block host even if allowlisted")
    r.add_argument("--upstream-proxy", default=None, help="squid.corp:3128 passthrough")
    r.add_argument("--open-port", action="append", default=[], help="localhost IPC port exception")
    r.add_argument("--allow-endpoint", action="append", default=[],
                   help="Service:METHOD:/glob, repeatable (e.g. openai:POST:/v1/chat/*)")
    r.add_argument("--block-net", action="store_true", help="deny all network in kernel mode")
    r.add_argument("--backend", default="local", choices=["local", "docker", "nono"],
                   help="local=Seatbelt/soft on host, docker=exec in container, nono=delegate to nono engine")
    r.add_argument("--image", default="ubuntu:24.04", help="container image (docker backend)")
    r.add_argument("--env", action="append", default=[], help="KEY=VAL passthrough into container (docker only)")
    r.add_argument("--container-user", default=None, help="UID:GID for the container process (docker only)")
    r.add_argument("--nono-profile", default=None, help="nono profile name/path (nono backend only)")
    r.add_argument("--ask-socket", default=None, help="approval broker socket (GUI); default: ask on terminal")
    r.add_argument("--ask-timeout", type=int, default=120, help="seconds to wait for socket approval (deny on timeout)")
