def _argv_match(argv: list[str], rule: dict) -> bool:
    spec = rule.get("argv", {})
    if "prefix" in spec:
        pre = spec["prefix"]
        return argv[:len(pre)] == pre
    if "exact" in spec:
        return argv == spec["exact"]
    if "contains" in spec:
        want = spec["contains"]
        return all(t in argv for t in want)
    return False


def _check_invocation_policy(tool: str, argv: list[str], inv: dict) -> tuple[str, str] | None:
    for rule in inv.get("deny", []) or []:
        if _argv_match(argv, rule):
            return "deny", f"tool '{tool}' argv denied by policy"
    allows = inv.get("allow", []) or []
    if allows:
        for rule in allows:
            if _argv_match(argv, rule):
                return None  # allowed → fall through to argv_verdict
        return "deny", f"tool '{tool}' argv not in allow-list"
    if (inv.get("default") or "allow") == "deny":
        return "deny", f"tool '{tool}' default deny"
    return None


def tool_caller() -> str:
    """Name of the process that invoked this tool (for can_use edges).

    SOTERIA_BROKER_CALLER overrides (tests); else parent comm via ps.
    Unknown → 'session' (documented compat fallback).
    """
    env = os.environ.get("SOTERIA_BROKER_CALLER", "").strip()
    if env:
        return os.path.basename(env)
    try:
        pr = subprocess.run(["ps", "-o", "comm=", "-p", str(os.getppid())],
                            capture_output=True, text=True, timeout=5)
        comm = (pr.stdout or "").strip().splitlines()
        if pr.returncode == 0 and comm and comm[0].strip():
            return os.path.basename(comm[0].strip())
    except OSError:
        pass
    return "session"


def tool_verdict(cmd: list[str], profile_policies: dict | None,
                 caller: str = "session") -> tuple[str, str] | None:
    """Return (verdict, reason) if a tool policy applies, else None to fall through.
    Merges DEFAULT_TOOL_POLICIES with profile command_policies.commands (profile wins).
    caller='session' for top-level runs; the broker passes the parent tool for
    can_use/from edges (e.g. git may invoke ssh while session ssh stays denied).
    """
    if not cmd:
        return None
    raw = cmd[0]
    tool = os.path.basename(raw) if "/" in raw else raw
    merged: dict[str, dict] = dict(DEFAULT_TOOL_POLICIES)
    for k, v in (profile_policies or {}).get("commands", {}).items():
        merged[k] = v
    pol = merged.get(tool)
    if pol is None:
        # direct-path to a controlled tool still controlled
        return None
    if raw != tool and tool in merged:
        # /bin/gh etc → same policy as gh (no bypass)
        pass
    from_map = pol.get("from") or {}
    if caller != "session" and caller in from_map:
        entry = from_map[caller]
        if entry == "deny":
            return "deny", f"tool '{tool}' denied for caller '{caller}'"
        if isinstance(entry, dict):
            inv = entry.get("invocation_policy") or pol.get("invocation_policy")
            if inv:
                hit = _check_invocation_policy(tool, cmd[1:], inv)
                if hit is not None:
                    return hit
            return None
    if caller != "session":
        caller_pol = merged.get(caller)
        if isinstance(caller_pol, dict):
            can_use = caller_pol.get("can_use")
            if can_use is not None and tool not in can_use:
                return "deny", f"tool '{tool}' not in '{caller}' can_use"
        # else: fall through to the tool's session policy below
    sess = from_map.get("session", None)
    if sess == "deny":
        scope = f"caller '{caller}'" if caller != "session" else "session"
        return "deny", f"tool '{tool}' denied for {scope} (deny-only)"
    if isinstance(sess, dict):
        inv = sess.get("invocation_policy") or pol.get("invocation_policy")
        if inv:
            hit = _check_invocation_policy(tool, cmd[1:], inv)
            if hit is not None:
                return hit
    return None


def split_csv_flags(vals: list[str] | None) -> list[str]:
    out: list[str] = []
    for v in vals or []:
        out += [x.strip() for x in str(v).split(",") if x.strip()]
    return out


def effective_tool_commands(profile_policies: dict | None,
                            extra_deny: list[str] | None = None,
                            allow_exempt: list[str] | None = None) -> dict:
    """Merged tool-name -> policy for shims and gates.

    DEFAULT_TOOL_POLICIES + profile commands + --deny-commands as deny-only.
    --allow-command removes a tool from mediation entirely (loud escape hatch).
    """
    merged: dict[str, dict] = dict(DEFAULT_TOOL_POLICIES)
    for k, v in (profile_policies or {}).get("commands", {}).items():
        merged[k] = v
    for t in extra_deny or []:
        merged.setdefault(t, {"from": {"session": "deny"}})
    exempt = {t.lower() for t in (allow_exempt or [])}
    return {k: v for k, v in merged.items() if k.lower() not in exempt}


def resolve_real_binary(tool: str, shim_dir: str, path: str | None = None) -> str | None:
    """First executable named tool on PATH skipping the shim dir (anti-spoof)."""
    shim_r = os.path.realpath(shim_dir) if shim_dir else ""
    for d in ((path if path is not None else os.environ.get("PATH", "")) or "").split(os.pathsep):
        if not d:
            continue
        try:
            if shim_r and os.path.realpath(d) == shim_r:
                continue
        except OSError:
            continue
        cand = os.path.join(d, tool)
        try:
            if os.path.isfile(cand) and os.access(cand, os.X_OK) and not os.path.isdir(cand):
                return cand
        except OSError:
            continue
    return None


def build_shims(tools: list[str], soteria_argv: list[str], dest: Path) -> list[str]:
    """Write tiny sh shims (one per tool) that re-enter via `soteria _broker`.

    Returns the tools actually shimmed. Shims + policy file are chmodded
    read-only as a speed bump (kernel/docker/nono backends are the real
    tamper boundary; soft mode is accidents-only).
    """
    import shlex as _shlex
    made: list[str] = []
    dest.mkdir(parents=True, exist_ok=True)
    prefix = " ".join(_shlex.quote(x) for x in soteria_argv)
    for tool in sorted(set(tools)):
        if not tool or "/" in tool or tool.startswith("-"):
            continue
        p = dest / tool
        p.write_text(f"#!/bin/sh\n# soteria tool shim — do not edit (regenerated per run)\n"
                     f"exec {prefix} _broker --tool {_shlex.quote(tool)} -- \"$@\"\n")
        try:
            os.chmod(p, 0o555)
        except OSError:
            pass
        made.append(tool)
    return made


def cmd_broker(args) -> int:
    """Per-tool gate for shim children. Supervised via daemon when available, else legacy in-box gate+exec."""
    tool = getattr(args, "tool", None) or ""
    argv = list(getattr(args, "broker_cmd", []) or [])
    if argv[:1] == ["--"]:
        argv = argv[1:]
    sock_path = os.environ.get("SOTERIA_BROKER_SOCK", "")
    if sock_path and os.path.exists(sock_path):
        rc = broker_forward(sock_path, tool, argv)
        if rc is not None:
            return rc
        audit({"kind": "broker.fallback", "level": "INFO",
               "session_id": os.environ.get("SOTERIA_SESSION_ID", "broker"),
               "summary": f"{tool} daemon unreachable, legacy in-box gate", "tool": tool})
    pol_path = os.environ.get("SOTERIA_BROKER_POLICY", "")
    shim_dir = os.environ.get("SOTERIA_SHIM_DIR", "")
    sid = os.environ.get("SOTERIA_SESSION_ID", "broker")
    try:
        pol = json.loads(Path(pol_path).read_text()) if pol_path else {}
    except OSError:
        print(f"soteria DENY: broker policy unreadable", file=sys.stderr)
        return 3
    full = [tool] + argv
    caller = tool_caller()
    tp = tool_verdict(full, {"commands": pol.get("commands", {})}, caller=caller)
    if tp is not None:
        verdict, reason = tp
    else:
        deny = set(DEFAULT_DENY_CMDS) | {t for t in pol.get("deny_commands", [])}
        verdict, reason = argv_verdict(full, deny, pol.get("ask_mode", "escalations"))
    audit({"kind": f"broker.{verdict}", "level": verdict.upper(), "session_id": sid,
           "summary": f"{' '.join(full)} — {reason} (caller {caller})", "tool": tool})
    if verdict == "deny":
        print(f"soteria DENY: {reason} (hint: --allow-command {tool} to exempt)", file=sys.stderr)
        return 3
    if verdict == "ask":
        sock = os.environ.get("SOTERIA_ASK_SOCKET", "") or pol.get("ask_socket")
        timeout = int(os.environ.get("SOTERIA_ASK_TIMEOUT", "") or pol.get("ask_timeout", 120) or 120)
        ok = False
        if sock:
            ok = ask_via_socket(sock, {"session_id": sid, "command": full,
                                       "reason": reason, "cwd": os.getcwd()}, timeout)
        elif sys.stdin.isatty():
            ok = ask_human(f"soteria ASK ({reason}). allow once?")
        audit({"kind": f"broker.ask.{'allow' if ok else 'deny'}", "level": "INFO",
               "session_id": sid, "summary": f"{' '.join(full)} — {reason}"})
        if not ok:
            print(f"soteria: denied ({reason})", file=sys.stderr)
            return 3
    real = resolve_real_binary(tool, shim_dir)
    if real is None:
        print(f"soteria DENY: no real binary for '{tool}' off shim PATH", file=sys.stderr)
        return 3
    try:
        os.execv(real, [real] + argv)
    except OSError as e:
        print(f"soteria: exec failed for {real}: {e}", file=sys.stderr)
        return 127
    return 127


# --- P16: host-side broker daemon (supervisor spawns tools, applies per-tool box) ---
DAEMON_TOOL_TIMEOUT_DEFAULT = 300
DAEMON_MAX_DEPTH = 8
DAEMON_IO_CAP = 1024 * 1024


def parse_size(s: str | int | None) -> int | None:
    """Parse '512M' -> bytes. Bare ints = bytes. '0'/None/'' = None (no cap)."""
    if s is None:
        return None
    if isinstance(s, int):
        return s if s > 0 else None
    t = str(s).strip()
    if t == "" or t == "0":
        return None
    import re as _re
    m = _re.fullmatch(r"(\d+)\s*([KkMmGg])?\s*([Bb])?", t)
    if not m:
        raise ValueError(f"bad size {s!r} (want e.g. 512M, 1024, 2G)")
    n = int(m.group(1))
    if n <= 0:
        return None
    mult = {"": 1, "K": 1024, "M": 1024 ** 2, "G": 1024 ** 3}[(m.group(2) or "").upper()]
    return n * mult


def _make_limits_preexec(memory_bytes: int | None, max_processes: int | None,
                         cpu_seconds: int | None, cgroup_scope: str | None = None):
    """Build preexec_fn applying rlimits (+ best-effort cgroup join). Fail-closed.

    Runs in the forked child before exec: keep tiny. cgroup failures are
    swallowed (fallback to setrlimit-only); rlimit failures _exit(127).
    """
    def _fn() -> None:
        try:
            import resource as _r
            import sys as _sys
            if cpu_seconds:
                v = int(cpu_seconds)
                if v > 0:
                    _r.setrlimit(_r.RLIMIT_CPU, (v, v))
            if max_processes:
                n = int(max_processes)
                if n > 0 and hasattr(_r, "RLIMIT_NPROC"):
                    _r.setrlimit(_r.RLIMIT_NPROC, (n, n))
            if memory_bytes:
                b = int(memory_bytes)
                # Darwin: any finite RLIMIT_AS/RSS breaks dyld at exec
                # (verified: /bin/echo rc=127 even at 8G). Memory caps are
                # Linux-only; macOS keeps CPU+NPROC + the timeout watchdog.
                if b > 0 and _sys.platform != "darwin" and hasattr(_r, "RLIMIT_AS"):
                    _r.setrlimit(_r.RLIMIT_AS, (b, b))
            if cgroup_scope:
                try:
                    _cgroup_join_child(cgroup_scope, memory_bytes, max_processes)
                except Exception:
                    pass
        except Exception:
            import os as _os2
            _os2._exit(127)
    return _fn


def _cgroup_join_child(scope: str, memory_bytes: int | None, max_processes: int | None) -> bool:
    """Best-effort cgroup-v2 join from inside preexec. False = fall back to rlimits."""
    import os as _os
    try:
        base = "/sys/fs/cgroup"
        try:
            with open(os.path.join(base, "cgroup.controllers"), "r") as f:
                f.read(1)
        except OSError:
            return False
        dest = os.path.join(base, scope)
        try:
            _os.makedirs(dest, exist_ok=True)
        except OSError:
            return False
        if memory_bytes and int(memory_bytes) > 0:
            try:
                with open(os.path.join(dest, "memory.max"), "w") as f:
                    f.write(str(int(memory_bytes)))
            except OSError:
                pass
        if max_processes and int(max_processes) > 0:
            try:
                with open(os.path.join(dest, "pids.max"), "w") as f:
                    f.write(str(int(max_processes)))
            except OSError:
                pass
        try:
            with open(os.path.join(dest, "cgroup.procs"), "w") as f:
                f.write(str(_os.getpid()))
        except OSError:
            return False
        return True
    except Exception:
        return False


def _cgroup_scope_for(sid: str) -> str:
    import os as _os
    safe = "".join(c if (c.isalnum() or c in "-_") else "-" for c in str(sid or "run"))[:48]
    return f"soteria-{safe}-{_os.getpid()}"


def _cgroup_cleanup(scope: str) -> None:
    import shutil as _sh
    try:
        _sh.rmtree(os.path.join("/sys/fs/cgroup", scope), ignore_errors=True)
    except Exception:
        pass

TOOL_SANDBOX_DEFAULTS: dict[str, dict] = {
    "gh": {"fs_read": ["."], "fs_write": []},
    "git": {"fs_read": ["."], "fs_write": ["."]},
}


def tool_sandbox_for(tool: str, commands: dict) -> dict:
    pol = (commands or {}).get(tool, {})
    sb = dict(pol.get("sandbox") or {})
    if not sb:
        sb = dict(TOOL_SANDBOX_DEFAULTS.get(tool, {"fs_read": ["."], "fs_write": ["."]}))
    sb.setdefault("fs_read", [])
    sb.setdefault("fs_write", [])
    return sb


def _resolve_tool_dirs(entries: list[str], cwd: str) -> list[str]:
    out = []
    for e in entries or []:
        if e == ".":
            out.append(os.path.realpath(cwd))
        else:
            out.append(os.path.realpath(os.path.expanduser(e)))
    return out


def write_tool_sb_text(tool: str, reads: list[str], writes: list[str],
                       proxy_port: int | None = None, block_net: bool = False,
                       deny_paths: list[str] | None = None) -> str:
    """Seatbelt profile text scoping ONE tool: listed reads/writes + tmp + /dev."""
    home = str(Path.home())
    r = lambda p: os.path.realpath(os.path.expanduser(p))
    tmpdirs = sorted({r(p) for p in [os.environ.get("TMPDIR", "/tmp"), "/tmp", "/private/tmp"] if os.path.exists(p)})
    lines = ["(version 1)", "(allow default)"]
    for p in reads + ["/dev"]:
        lines.append(f'(allow file-read* (subpath "{sbpl_escape(p)}"))')
    for p in writes + tmpdirs:
        lines.append(f'(allow file-write* (subpath "{sbpl_escape(p)}"))')
    lines.append("(deny file-write*)")
    for d in deny_paths or []:
        try:
            lines.append(f'(deny file-read* (subpath "{sbpl_escape(r(d))}"))')
        except OSError:
            continue
    if proxy_port or block_net:
        lines.append("(deny network*)")
    if proxy_port:
        lines.append('(allow network-outbound (remote tcp "localhost:*"))')
    lines.append("")
    return "\n".join(lines)


class _Daemon:
    """Per-run supervisor: gates tool requests from shims, spawns boxed tools.

    Runs as a thread in the `run` process (host side, never inside the box).
    Children are forked per request so Seatbelt/Landlock scoping never touches
    the supervisor itself.
    """

    def __init__(self, sock_path: str, ctx: dict):
        self.sock_path = sock_path
        self.ctx = ctx
        self._srv: socket.socket | None = None
        self._thread: threading.Thread | None = None
        self._sb_cache: dict[tuple[str, str], str] = {}

    def start(self) -> None:
        try:
            os.unlink(self.sock_path)
        except OSError:
            pass
        parent = os.path.dirname(self.sock_path)
        try:
            os.makedirs(parent, exist_ok=True)
            os.chmod(parent, 0o700)
        except OSError:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(self.sock_path)
        try:
            os.chmod(self.sock_path, 0o600)
        except OSError:
            pass
        srv.listen(50)
        srv.settimeout(0.5)
        self._srv = srv
        th = threading.Thread(target=self._loop, daemon=True)
        th.start()
        self._thread = th

    def stop(self) -> None:
        srv, self._srv = self._srv, None
        if srv is not None:
            try:
                srv.close()
            except OSError:
                pass
        try:
            os.unlink(self.sock_path)
        except OSError:
            pass

    def _loop(self) -> None:
        while self._srv is not None:
            try:
                conn, _ = self._srv.accept()
            except OSError:
                continue
            t = threading.Thread(target=self._handle, args=(conn,), daemon=True)
            t.start()

    def _handle(self, conn: socket.socket) -> None:
        with conn:
            try:
                line = conn.makefile("r").readline(4 * 1024 * 1024)
                req = json.loads(line)
            except Exception:
                return
            try:
                resp = daemon_handle_request(req, self.ctx, self._sb_cache)
            except Exception as e:
                resp = {"error": f"daemon failure: {type(e).__name__}"}
            try:
                conn.sendall((json.dumps(resp) + "\n").encode())
            except OSError:
                pass


def daemon_handle_request(req: dict, ctx: dict, sb_cache: dict | None = None) -> dict:
    """Gate + spawn one tool. Pure-ish (spawns a real child). Returns response dict."""
    import base64 as _b64
    sid = ctx.get("sid", "broker")
    tool = str(req.get("tool", "") or "")
    argv = [str(a) for a in (req.get("argv", []) or [])]
    cwd = str(req.get("cwd", "") or ctx.get("proj", ""))
    caller = str(req.get("caller", "") or "session")
    depth = int(req.get("depth", 0) or 0)
    if not tool or "/" in tool or tool.startswith("-"):
        return {"error": "bad tool name"}
    if depth > DAEMON_MAX_DEPTH:
        audit({"kind": "broker.deny", "level": "DENY", "session_id": sid,
               "summary": f"{tool} — broker depth cap ({depth})", "tool": tool})
        return {"exit": 3, "stdout_b64": "", "stderr_b64": _b64.b64encode(b"soteria DENY: broker depth cap\n").decode(),
                "truncated": False}
    try:
        cwd_r = os.path.realpath(cwd)
        proj_r = os.path.realpath(ctx.get("proj", cwd_r))
        if cwd_r != proj_r and not cwd_r.startswith(proj_r.rstrip("/") + "/"):
            return {"exit": 3, "stdout_b64": "",
                    "stderr_b64": _b64.b64encode(b"soteria DENY: tool cwd outside project\n").decode(),
                    "truncated": False}
    except OSError:
        return {"exit": 3, "stdout_b64": "", "stderr_b64": _b64.b64encode(b"soteria DENY: bad cwd\n").decode(),
                "truncated": False}
    commands = ctx.get("commands", {})
    full = [tool] + argv
    tp = tool_verdict(full, {"commands": commands}, caller=caller)
    if tp is not None:
        verdict, reason = tp
    else:
        deny = set(DEFAULT_DENY_CMDS) | set(ctx.get("deny_commands", []))
        verdict, reason = argv_verdict(full, deny, ctx.get("ask_mode", "escalations"))
    audit({"kind": f"broker.{verdict}", "level": verdict.upper(), "session_id": sid,
           "summary": f"{' '.join(full)} — {reason} (caller {caller}, supervised)", "tool": tool})
    if verdict == "deny":
        return {"exit": 3, "stdout_b64": "",
                "stderr_b64": _b64.b64encode(f"soteria DENY: {reason}\n".encode()).decode(),
                "truncated": False}
    if verdict == "ask":
        sock = ctx.get("ask_socket")
        timeout = int(ctx.get("ask_timeout", 120) or 120)
        ok = ask_via_socket(sock, {"session_id": sid, "command": full,
                                   "reason": reason, "cwd": cwd_r}, timeout) if sock else False
        audit({"kind": f"broker.ask.{'allow' if ok else 'deny'}", "level": "INFO",
               "session_id": sid, "summary": f"{' '.join(full)} — {reason} (supervised)"})
        if not ok:
            return {"exit": 3, "stdout_b64": "",
                    "stderr_b64": _b64.b64encode(f"soteria: denied ({reason})\n".encode()).decode(),
                    "truncated": False}
    shim_dir = ctx.get("shim_dir", "")
    base_path = ctx.get("base_path", "")
    _r = None
    for d in (base_path or "").split(os.pathsep):
        if not d:
            continue
        try:
            if shim_dir and os.path.realpath(d) == os.path.realpath(shim_dir):
                continue
        except OSError:
            continue
        cand = os.path.join(d, tool)
        try:
            if os.path.isfile(cand) and os.access(cand, os.X_OK):
                _r = cand
                break
        except OSError:
            continue
    if _r is None:
        return {"exit": 3, "stdout_b64": "",
                "stderr_b64": _b64.b64encode(f"soteria DENY: no real binary for '{tool}'\n".encode()).decode(),
                "truncated": False}
    env = dict(ctx.get("base_env", {}))
    env["SOTERIA_BROKER_DEPTH"] = str(depth + 1)
    timeout = int(ctx.get("tool_timeout", DAEMON_TOOL_TIMEOUT_DEFAULT) or DAEMON_TOOL_TIMEOUT_DEFAULT)
    try:
        mem = ctx.get("memory_bytes")
        mem = int(mem) if mem else None
        if mem is not None and mem <= 0:
            mem = None
    except (TypeError, ValueError):
        mem = None
    try:
        nproc = ctx.get("max_processes")
        nproc = int(nproc) if nproc else None
        if nproc is not None and nproc <= 0:
            nproc = None
    except (TypeError, ValueError):
        nproc = None
    spawn = [_r] + argv
    use_sb = (sys.platform == "darwin" and shutil.which("sandbox-exec")
              and not os.environ.get("SOTERIA_BOXED") and ctx.get("seatbelt", True))
    if use_sb:
        sb = tool_sandbox_for(tool, commands)
        reads = _resolve_tool_dirs(sb["fs_read"], cwd_r)
        writes = _resolve_tool_dirs(sb["fs_write"], cwd_r)
        key = (tool, cwd_r)
        prof = (sb_cache or {}).get(key)
        if prof is None:
            prof = os.path.join(ctx.get("shim_dir", "/tmp"), f"sb-{tool}-{abs(hash(key)) % 10**8}.sb")
            try:
                Path(prof).write_text(write_tool_sb_text(
                    tool, reads, writes, ctx.get("proxy_port"),
                    ctx.get("block_net", False), ctx.get("deny_paths")))
                try:
                    os.chmod(prof, 0o444)
                except OSError:
                    pass
            except OSError as e:
                audit({"kind": "broker.sb_fail", "level": "INFO", "session_id": sid,
                       "summary": f"{tool} profile write failed ({e}), plain spawn"})
                prof = None
            else:
                if sb_cache is not None:
                    if len(sb_cache) > 256:
                        sb_cache.clear()
                    sb_cache[key] = prof
        if prof is not None:
            spawn = ["sandbox-exec", "-f", prof] + spawn
    scope = _cgroup_scope_for(sid) if (mem or nproc) else None
    preexec = _make_limits_preexec(mem, nproc, timeout, scope) if (mem or nproc or timeout) else None
    try:
        pr = subprocess.run(spawn, cwd=cwd_r, env=env, capture_output=True, timeout=timeout,
                            preexec_fn=preexec)
        out, err, trunc, rc = pr.stdout, pr.stderr, False, pr.returncode
    except subprocess.TimeoutExpired as e:
        out, err, trunc, rc = (e.stdout or b""), (e.stderr or b""), True, 124
    except OSError as e:
        return {"exit": 127, "stdout_b64": "",
                "stderr_b64": _b64.b64encode(f"soteria: exec failed: {e}\n".encode()).decode(),
                "truncated": False}
    finally:
        if scope:
            _cgroup_cleanup(scope)
    if len(out) > DAEMON_IO_CAP:
        out, trunc = out[:DAEMON_IO_CAP], True
    if len(err) > DAEMON_IO_CAP:
        err, trunc = err[:DAEMON_IO_CAP], True
    if rc == 124:
        limit = "timeout"
    elif rc == 137:
        limit = "memory"  # SIGKILL under a cap ~= cgroup OOM (rarely an external kill)
    elif rc in (-24, -25):
        limit = "cpu"  # SIGXCPU/SIGXFSZ from the RLIMIT_CPU backstop
    elif rc == 127 and (mem or nproc):
        limit = "rlimit"  # exec failed under a cap
    elif (mem or nproc) and rc != 0:
        limit = "processes" if nproc else "memory"
    else:
        limit = "ok" if (mem or nproc) else "none"
    audit({"kind": "broker.exec", "level": "INFO", "session_id": sid,
           "summary": f"{tool} exit={rc} out={len(out)}B err={len(err)}B limit={limit}" + (" truncated" if trunc else ""),
           "tool": tool, "rc": rc, "limit": limit})
    return {"exit": rc, "stdout_b64": _b64.b64encode(out).decode(),
            "stderr_b64": _b64.b64encode(err).decode(), "truncated": trunc}


def broker_forward(sock_path: str, tool: str, argv: list[str]) -> int | None:
    """Forward one tool invocation to the supervisor daemon. None = fall back to legacy."""
    import base64 as _b64
    try:
        depth = int(os.environ.get("SOTERIA_BROKER_DEPTH", "0") or 0)
    except ValueError:
        depth = 0
    req = {"v": 1, "id": uuid.uuid4().hex, "tool": tool, "argv": argv,
           "cwd": os.getcwd(), "caller": tool_caller(), "depth": depth}
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(10)
        s.connect(sock_path)
        s.settimeout(None)
        s.sendall((json.dumps(req) + "\n").encode())
        data = b""
        while not data.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            data += chunk
            if len(data) > 4 * 1024 * 1024 + 1024:
                break
        s.close()
        resp = json.loads(data.decode())
    except Exception:
        return None
    if "error" in resp and "exit" not in resp:
        return None
    try:
        sys.stdout.buffer.write(_b64.b64decode(resp.get("stdout_b64", "")))
        sys.stdout.buffer.flush()
        sys.stderr.buffer.write(_b64.b64decode(resp.get("stderr_b64", "")))
        sys.stderr.buffer.flush()
    except OSError:
        pass
    try:
        return int(resp.get("exit", 3))
    except (TypeError, ValueError):
        return 3


def ask_human(prompt: str) -> bool:
    try:
        ans = input(f"{prompt} [y/N]: ").strip().lower()
    except EOFError:
        ans = "n"
    return ans in ("y", "yes")


def ask_via_socket(sock_path: str, payload: dict, timeout: int) -> bool:
    """Approval over unix socket. Fail closed: any error/timeout/malformed = deny.

    Protocol: client sends one JSON line {v,id,session_id,command,reason,cwd,created},
    server replies one JSON line {decision: allow|deny}.
    """
    payload = {"v": 1, "id": uuid.uuid4().hex, "created": ts(), **payload}
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.settimeout(5)
        s.connect(sock_path)
        s.settimeout(timeout)
        s.sendall((json.dumps(payload) + "\n").encode())
        data = b""
        while not data.endswith(b"\n"):
            chunk = s.recv(4096)
            if not chunk:
                break
            data += chunk
            if len(data) > 65536:
                break
        return json.loads(data.decode()).get("decision") == "allow"
    except Exception:
        return False
    finally:
        try:
            s.close()
        except Exception:
            pass


def cmd_ask_listen(args) -> int:
    """Reference approver: prints requests, prompts on terminal, replies. Stand-in for the GUI."""
    path = args.socket
    try:
        os.unlink(path)
    except OSError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(path)
    srv.listen(5)
    print(f"soteria ask-listen: {path} (Ctrl-C to stop)")
    try:
        while True:
            conn, _ = srv.accept()
            with conn:
                line = conn.makefile("r").readline()
                try:
                    req = json.loads(line)
                except Exception:
                    req = {"raw": line[:200]}
                print(f"\n--- approval {req.get('id', '?')} ---")
                print(f"$ {' '.join(req.get('command', []))}")
                print(f"reason: {req.get('reason', '')}  cwd: {req.get('cwd', '')}")
                ok = ask_human("allow once?")
                conn.sendall((json.dumps({"decision": "allow" if ok else "deny"}) + "\n").encode())
                audit({"kind": f"ask.{'allow' if ok else 'deny'}", "level": "INFO",
                       "session_id": req.get("session_id", "?"),
                       "summary": f"{' '.join(req.get('command', []))} (terminal approver)"})
    except KeyboardInterrupt:
        pass
    finally:
        srv.close()
        try:
            os.unlink(path)
        except OSError:
            pass
    return 0


def scrub_env(creds: list[str], allow_env: list[str] | None = None,
              deny_env: list[str] | None = None, set_env: dict | None = None) -> dict:
    env = dict(os.environ)
    for k in SECRET_ENV:
        env.pop(k, None)
    # explicit deny_vars (supports PREFIX_* wildcards) — nono parity
    for k in list(env.keys()):
        if deny_env and env_match(k, deny_env):
            env.pop(k, None)
    # allow-list mode: if caller passes --allow-env, drop everything except safe + allowed + phantom targets
    if allow_env:
        keep = set(SAFE_ENV_DEFAULT)
        phantom_targets = {CRED_ENV_VARS.get(c.lower(), "").upper() for c in (creds or [])}
        for k in list(env.keys()):
            if k in keep or env_match(k, SAFE_ENV_DEFAULT) or env_match(k, allow_env) or k in phantom_targets:
                continue
            # always keep SOTERIA_* plumbing
            if k.startswith("SOTERIA_"):
                continue
            env.pop(k, None)
    env["SOTERIA_BOXED"] = "1"  # nested auto-runs degrade to soft (Seatbelt can't re-apply)
    for c in creds:
        var = CRED_ENV_VARS.get(c.lower())
        if var and var not in env:
            env[var] = f"soteria_phantom_{c.lower()}"
    for k, v in (set_env or {}).items():
        if k == "PATH" or k.startswith("NONO_"):
            continue  # reserved, never override
        env[k] = v
    return env


