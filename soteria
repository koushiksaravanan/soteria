def _host_of_entry(entry: str) -> str:
    e = (entry or "").strip()
    if "://" in e:
        try:
            return urlsplit(e).hostname or e
        except Exception:
            return e
    return e.split("/")[0].split(":")[0]


def _host_match(host: str, pattern: str) -> bool:
    h, p = (host or "").lower(), (pattern or "").lower()
    h = _host_of_entry(h)
    p = _host_of_entry(p)
    if not h or not p:
        return False
    if h == p:
        return True
    if p.startswith("*."):
        return h.endswith(p[1:]) and len(h) > len(p[1:])
    try:
        return fnmatch.fnmatch(h, p)
    except Exception:
        return False


def resolve_credential_value(ref: str, parent_env: dict) -> str | None:
    """Resolve env://VAR, file://PATH, op://..., keyring://svc/acct, or plain env fallback."""
    if not ref:
        return None
    if ref.startswith("env://"):
        return parent_env.get(ref[6:]) or os.environ.get(ref[6:])
    if ref.startswith("file://"):
        try:
            p = Path(os.path.expanduser(ref[7:]))
            if p.is_file():
                return p.read_text().strip().splitlines()[0].strip()
        except OSError:
            return None
        return None
    if ref.startswith("op://"):
        op = shutil.which("op")
        if not op:
            return None
        try:
            pr = subprocess.run([op, "read", ref], capture_output=True, text=True, timeout=15)
            if pr.returncode == 0 and pr.stdout.strip():
                return pr.stdout.strip()
        except OSError:
            pass
        return None
    if ref.startswith("keyring://"):
        try:
            _, rest = ref.split("://", 1)
            svc, _, acct = rest.partition("/")
            if sys.platform == "darwin":
                pr = subprocess.run(["security", "find-generic-password", "-s", svc,
                                     "-a", acct or ref, "-w"],
                                    capture_output=True, text=True, timeout=10)
                if pr.returncode == 0 and pr.stdout.strip():
                    return pr.stdout.strip()
        except OSError:
            pass
        return None
    # plain account name under soteria service (macOS) or env passthrough
    if parent_env.get(ref):
        return parent_env[ref]
    return None


def real_key_for(svc: str, cfg: dict, parent_env: dict) -> str | None:
    # custom credential_key ref (op://, env://, file://, keyring://) takes precedence
    ck = cfg.get("credential_key")
    if ck and ck not in (cfg.get("keychain"),):
        v = resolve_credential_value(ck, parent_env)
        if v:
            return v
    for var in cfg.get("env", []):
        if parent_env.get(var):
            return parent_env[var]
    if sys.platform == "darwin":  # Keychain fallback
        try:
            p = subprocess.run(["security", "find-generic-password", "-s", "soteria",
                                "-a", cfg["keychain"], "-w"],
                               capture_output=True, text=True, timeout=10)
            if p.returncode == 0 and p.stdout.strip():
                return p.stdout.strip()
        except OSError:
            pass
    return None


class _ProxyHandler(BaseHTTPRequestHandler):
    server_version = "soteria-proxy"

    def log_message(self, *a):
        pass

    def _deny(self, code: int, summary: str):
        try:
            audit({"kind": "proxy.deny", "level": "DENY",
                   "session_id": self.server.soteria_sid, "summary": summary})
        except OSError:
            pass  # audit must never break a proxied request
        body = summary.encode()
        self.send_response(code)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _proxy(self):
        routes = self.server.soteria_routes
        path_q = self.path.split("?", 1)
        segs = path_q[0].lstrip("/").split("/", 1)
        route = routes.get(segs[0]) if segs else None
        rest = "/" + (segs[1] if len(segs) > 1 else "")
        if route is None:
            return self._deny(404, f"no proxy route for {path_q[0][:80]}")
        if self.headers.get("X-Soteria-Token") != route["token"]:
            return self._deny(407, "bad proxy token")
        # P2: always-denied + deny_domain enforcement at L7 boundary
        up_host = urlsplit(route["upstream"]).hostname or ""
        if is_always_denied_host(up_host):
            return self._deny(403, f"upstream {up_host} always-denied (metadata/link-local)")
        if up_host.lower() in {d.lower() for d in (route.get("deny_domains") or [])}:
            return self._deny(403, f"upstream {up_host} in deny_domain")
        if route["rules"] and not any(m == self.command and fnmatch.fnmatch(rest, g)
                                      for m, g in route["rules"]):
            return self._deny(403, f"{route['name']} {self.command} {rest} not in endpoint rules")
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(min(length, PROXY_BODY_LIMIT)) if length else None
        up = urlsplit(route["upstream"])
        fwd_path = (up.path.rstrip("/") + rest) if up.path else rest
        if len(path_q) > 1:
            fwd_path += "?" + path_q[1]
        headers = {k: v for k, v in self.headers.items()
                   if k.lower() not in STRIP_HEADERS and k.lower() not in ("host", "x-soteria-token", "content-length")}
        headers[route["header"]] = route["format"].format(route["key"])
        try:
            conn = (http.client.HTTPSConnection(up.hostname, up.port or 443, timeout=30)
                    if up.scheme == "https"
                    else http.client.HTTPConnection(up.hostname, up.port or 80, timeout=30))
            conn.request(self.command, fwd_path, body=body, headers=headers)
            resp = conn.getresponse()
            data = resp.read(PROXY_BODY_LIMIT + 1)
            status = resp.status
            rheaders = resp.getheaders()
        except Exception as e:
            return self._deny(502, f"upstream error: {type(e).__name__}")
        try:
            audit({"kind": "proxy.allow", "level": "ALLOW", "session_id": self.server.soteria_sid,
                   "summary": f"{route['name']} {self.command} {rest} -> {status}"})
        except OSError:
            pass  # audit must never break a proxied request
        self.send_response(status)
        for k, v in rheaders:
            if k.lower() not in ("transfer-encoding", "content-encoding", "content-length", "connection"):
                self.send_header(k, v)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _connect_auth_ok(self, token: str) -> bool:
        if self.headers.get("X-Soteria-Token") == token:
            return True
        auth = self.headers.get("Proxy-Authorization", "")
        if auth.startswith("Bearer "):
            return auth[7:].strip() == token
        if auth.startswith("Basic "):
            try:
                creds = base64.b64decode(auth[6:]).decode("utf-8", "replace")
            except Exception:
                return False
            userpass = creds.split(":", 1)
            return len(userpass) == 2 and userpass[1] == token
        return False

    def _connect_deny(self, target: str, reason: str):
        try:
            audit({"kind": "proxy.deny", "level": "DENY",
                   "session_id": self.server.soteria_sid,
                   "summary": f"CONNECT {target} {reason}"})
        except OSError:
            pass
        body = f"CONNECT denied: {reason}".encode()
        self.send_response(403)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        try:
            self.wfile.write(body)
        except OSError:
            pass

    def do_CONNECT(self):
        """CONNECT tunnel: domain-filtered TCP relay, TLS stays end-to-end."""
        cfg = getattr(self.server, "soteria_connect", None)
        if cfg is None:
            return self._deny(500, "CONNECT unavailable (proxy started without tunnel config)")
        target = (self.path or "").strip()
        host, _, port_s = target.rpartition(":")
        if not host or not port_s.isdigit():
            return self._connect_deny(target[:80], "malformed target, want host:port")
        port = int(port_s)
        if not self._connect_auth_ok(cfg.get("token", "")):
            try:
                audit({"kind": "proxy.deny", "level": "DENY",
                       "session_id": self.server.soteria_sid,
                       "summary": f"CONNECT {target[:80]} bad proxy token"})
            except OSError:
                pass
            body = b"proxy authentication required"
            self.send_response(407)
            self.send_header("Proxy-Authenticate", 'Basic realm="soteria"')
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            try:
                self.wfile.write(body)
            except OSError:
                pass
            return
        if is_always_denied_host(host):
            return self._connect_deny(target[:80], "denied_cidr (metadata/link-local)")
        if any(_host_match(host, d) for d in (cfg.get("deny") or [])):
            return self._connect_deny(target[:80], "deny_domain")
        if cfg.get("enforce") and not any(_host_match(host, a) for a in (cfg.get("allow") or [])):
            return self._connect_deny(target[:80], "not in allow-list")
        # DNS-rebinding check: resolve here, refuse metadata/link-local answers
        try:
            infos = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
        except OSError:
            return self._connect_deny(target[:80], "dns resolution failed")
        for info in infos:
            ip = info[4][0]
            if is_always_denied_host(ip):
                return self._connect_deny(target[:80], "denied_cidr (DNS-rebind)")
        up = socket.socket(infos[0][0], socket.SOCK_STREAM)
        up.settimeout(30)
        try:
            up.connect(infos[0][4])  # pinned sockaddr: no TOCTOU re-resolve
        except OSError:
            try:
                up.close()
            except OSError:
                pass
            return self._connect_deny(target[:80], "upstream unreachable")
        try:
            self.send_response(200, "Connection established")
            self.end_headers()
        except OSError:
            up.close()
            return
        try:
            audit({"kind": "proxy.connect_allow", "level": "ALLOW",
                   "session_id": self.server.soteria_sid,
                   "summary": f"CONNECT {target[:80]}"})
        except OSError:
            pass
        client = self.connection
        client.setblocking(False)
        up.setblocking(False)
        sent = 0
        deadline = time.time() + 300
        try:
            while time.time() < deadline:
                try:
                    r, _, _ = select.select([client, up], [], [], 30)
                except (OSError, ValueError):
                    break
                if not r:
                    continue
                idle = True
                for src, dst in ((client, up), (up, client)):
                    if src in r:
                        try:
                            chunk = src.recv(65536)
                        except OSError:
                            return
                        if not chunk:
                            return
                        try:
                            dst.sendall(chunk)
                        except OSError:
                            return
                        sent += len(chunk)
                        idle = False
                        if sent > 512 * 1024 * 1024:
                            return
                if idle:
                    continue
        finally:
            try:
                up.close()
            except OSError:
                pass

    do_GET = do_POST = do_PUT = do_DELETE = do_PATCH = do_HEAD = do_OPTIONS = _proxy


class _Proxy:
    def __init__(self, server: ThreadingHTTPServer, port: int, child_env: dict):
        self.server = server
        self.port = port
        self.child_env = child_env
        self.thread = threading.Thread(target=server.serve_forever, kwargs={"poll_interval": 0.2}, daemon=True)
        self.thread.start()

    def shutdown(self):
        try:
            self.server.shutdown()
        except Exception:
            pass
        self.server.server_close()


def start_proxy(svcs: list[str], parent_env: dict, sid: str,
                endpoint_rules: list[tuple[str, str, str]], base_host: str = "127.0.0.1",
                deny_domains: list[str] | None = None,
                custom_creds: dict | None = None,
                allow_domains: list[str] | None = None,
                network_profile: str | None = None,
                proxy_port: int = 0) -> _Proxy | None:
    import secrets as _secrets
    token = _secrets.token_hex(32)
    routes: dict[str, dict] = {}
    merged_services = dict(CRED_SERVICES)
    for name, cc in (custom_creds or {}).items():
        # custom_credentials: {upstream, credential_key, inject_header/format, env_var, prefix}
        lc = name.lower()
        merged_services[lc] = {
            "env": [cc.get("env_var", f"SOTERIA_{name.upper()}_KEY")] if cc.get("env_var") else [],
            "base_env": cc.get("base_env", f"{name.upper()}_BASE_URL"),
            "upstream": cc["upstream"],
            "header": cc.get("inject_header", "Authorization"),
            "format": cc.get("credential_format", "Bearer {}"),
            "keychain": cc.get("credential_key", name),
            "credential_key": cc.get("credential_key"),
            "prefix": cc.get("prefix", lc.replace("-", "_")),
        }
    prefix_to_base = {c["prefix"]: c["base_env"] for c in merged_services.values()}
    for svc in svcs:
        cfg = merged_services.get(svc.lower())
        if not cfg:
            print(f"soteria: unknown credential '{svc}' (known: {', '.join(sorted(merged_services))})", file=sys.stderr)
            continue
        key = real_key_for(svc, cfg, parent_env)
        if not key:
            print(f"soteria: no real key for '{svc}' (env {'/'.join(cfg.get('env', []))} or Keychain/op/file) — phantom only",
                  file=sys.stderr)
            audit({"kind": "proxy.skip", "level": "INFO", "session_id": sid,
                   "summary": f"no real key for {svc}"})
            continue
        if is_always_denied_host(urlsplit(os.environ.get(f"SOTERIA_UPSTREAM_{svc.lower()}", cfg["upstream"])).hostname or ""):
            print(f"soteria: refusing credential '{svc}' — upstream always-denied", file=sys.stderr)
            continue
        upstream = os.environ.get(f"SOTERIA_UPSTREAM_{svc.lower()}", cfg["upstream"])
        routes[cfg["prefix"]] = {"name": svc.lower(), "upstream": upstream,
                                 "header": cfg["header"], "format": cfg["format"],
                                 "key": key, "token": token,
                                 "deny_domains": list(deny_domains or []),
                                 "rules": [(m.upper(), g) for s, m, g in endpoint_rules if s.lower() == svc.lower()]}
    # P8: CONNECT tunnel config. The allow-list is explicit domains plus the
    # selected network_profile's groups (fail-closed like nono); deny and
    # always-denied apply on top. Credential-only runs thus still filter
    # generic egress to the profile's groups instead of leaving it open.
    group_hosts: list[str] = []
    for g in NETWORK_PROFILES.get((network_profile or "").lower(), []):
        group_hosts += NETWORK_GROUPS.get(g, [])
    explicit_filter = bool(allow_domains) or bool(deny_domains)
    connect_allow = list(dict.fromkeys(list(allow_domains or []) + group_hosts))
    if not routes and not explicit_filter:
        return None
    server = ThreadingHTTPServer(("127.0.0.1", proxy_port or 0), _ProxyHandler)
    server.soteria_routes = routes
    server.soteria_connect = {"token": token, "allow": connect_allow,
                              "deny": list(deny_domains or []),
                              "enforce": True}
    server.soteria_sid = sid
    port = server.server_address[1]
    proxy_url = f"http://soteria:{token}@{base_host}:{port}"
    child_env = {prefix_to_base[pre]: f"http://{base_host}:{port}/{pre}" for pre in routes}
    child_env["SOTERIA_PROXY_TOKEN"] = token
    child_env["HTTP_PROXY"] = proxy_url
    child_env["HTTPS_PROXY"] = proxy_url
    child_env["http_proxy"] = proxy_url
    child_env["https_proxy"] = proxy_url
    child_env["NO_PROXY"] = "localhost,127.0.0.1,::1"
    child_env["no_proxy"] = "localhost,127.0.0.1,::1"
    return _Proxy(server, port, child_env)


def write_sb_profile(proj: Path, sid: str | None, profile: str, extra_writes: list[str], proxy_port: int | None = None, block_net: bool = False, deny_paths: list[str] | None = None, shim_dir: str | None = None) -> Path:
    """Generate a Seatbelt profile: allow-default, box writes, blind secrets.

    Order matters (last match wins): broad allows first, bare write-deny,
    then secret read-denies last. All paths resolved (symlinks like /tmp
    would otherwise bypass subpath matching). Network: pinned to the
    localhost proxy when active, fully denied with --block-net, else open.
    deny_paths overrides SB_SECRET_DIRS when given (profile+groups resolved).
    shim_dir (under ~/.soteria) is re-allowed for reads AFTER the secret
    denies so tool shims stay runnable yet unwriteable (last match wins).
    """
    home = Path.home()
    r = lambda p: os.path.realpath(os.path.expanduser(p))
    proj_r = os.path.realpath(proj)
    tmpdirs = sorted({r(p) for p in [os.environ.get("TMPDIR", "/tmp"), "/tmp", "/private/tmp"] if os.path.exists(p)})
    state = [r(os.path.join(str(home), d)) for d in SB_STATE_BY_PROFILE.get(profile, [])]
    if deny_paths is None:
        secrets = [r(os.path.join(str(home), d)) for d in SB_SECRET_DIRS]
    else:
        secrets = []
        for d in deny_paths:
            try:
                secrets.append(r(d))
            except Exception:
                continue
    extra = [r(p) for p in extra_writes if os.path.exists(p)]

    lines = ["(version 1)", "(allow default)"]
    for p in [proj_r] + tmpdirs + ["/dev"] + state + extra:
        lines.append(f'(allow file-write* (subpath "{sbpl_escape(p)}"))')
    lines.append("(deny file-write*)")
    for p in secrets:
        lines.append(f'(deny file-read* (subpath "{sbpl_escape(p)}"))')
    if shim_dir:
        try:
            shim_r = r(shim_dir)
            lines.append(f'(allow file-read* (subpath "{sbpl_escape(shim_r)}"))')
        except OSError:
            pass
    if proxy_port:  # remote egress only via our localhost proxy; loopback stays open (MCP, nested runs)
        lines.append("(deny network*)")
        lines.append('(allow network-outbound (remote tcp "localhost:*"))')
    elif block_net:
        lines.append("(deny network*)")
    lines.append("")  # trailing newline
    dest = HOME / f"sb-{sid or time.strftime('%Y%m%d-%H%M%S')}.sb"
    HOME.mkdir(parents=True, exist_ok=True)
    dest.write_text("\n".join(lines))
    return dest


def resolve_enforce(requested: str) -> str:
    if os.environ.get("SOTERIA_BOXED"):
        return "soft"  # nested: Seatbelt apply is unreliable nested — deterministic soft + argv + audit
    if requested != "auto":
        return requested
    if sys.platform == "darwin" and shutil.which("sandbox-exec"):
        return "kernel"
    return "soft"


def _landlock_abi_for_release(release: str) -> str:
    """Estimate Landlock ABI from kernel release (pure, testable).

    v4+ (TCP rules) needs 6.7+, any Landlock needs 5.13+. This is an
    estimate — the LSM must also be compiled in and enabled.
    """
    import re as _re
    m = _re.match(r"(\d+)\.(\d+)", (release or "").strip())
    if not m:
        return "unknown"
    major, minor = int(m.group(1)), int(m.group(2))
    if (major, minor) >= (6, 7):
        return "v4+ (TCP + fs)"
    if (major, minor) >= (5, 13):
        return "v1-v3 (fs only)"
    return "none (needs 5.13+)"


def linux_landlock_info() -> dict:
    """Host Landlock/WSL report. Detection only — soteria has no native
    Landlock enforcement yet; Linux kernel isolation means --backend nono."""
    import platform as _plat
    release = _plat.release() if sys.platform.startswith("linux") else ""
    abi = _landlock_abi_for_release(release) if release else "n/a (not linux)"
    lsm_dir = os.path.isdir("/sys/kernel/security/landlock")
    wsl = False
    try:
        with open("/proc/version", encoding="utf-8", errors="replace") as f:
            wsl = "microsoft" in f.read().lower()
    except OSError:
        pass
    parts = [f"kernel {release or '?'}, ABI ~{abi}",
             "lsm mounted" if lsm_dir else "lsm not mounted"]
    if wsl:
        parts.append("WSL2 (Landlock TCP unavailable, use nono insecure_proxy only if you accept it)")
    if abi.startswith("v") and not lsm_dir:
        parts.append("no enforcement (LSM off?)")
    return {"kernel": release, "abi": abi, "lsm_mounted": lsm_dir, "wsl": wsl,
            "summary": "; ".join(parts)}


def _docker_available() -> bool:
    try:
        subprocess.run(["docker", "info"], capture_output=True, timeout=15, check=True)
        return True
    except Exception:
        return False


def build_docker_cmd(proj: Path, image: str, env_map: dict[str, str], cmd: list[str],
                     block_net: bool = False, container_user: str | None = None) -> list[str]:
    """Pure constructor: host project -> /workspace, minimal explicit env only.

    The container sees /workspace and nothing else of the host. Real secrets
    never cross: only phantom placeholders + proxy BASE_URLs + token + TERM-ish.
    """
    dc = ["docker", "run", "--rm", "-i",
          "-v", f"{proj}:/workspace:rw",
          "-w", "/workspace",
          "--cap-drop", "ALL", "--security-opt", "no-new-privileges",
          "--add-host", "host.docker.internal:host-gateway"]
    if block_net:
        dc += ["--network", "none"]
    if container_user:
        dc += ["--user", container_user]
    for k in sorted(env_map):
        dc += ["-e", f"{k}={env_map[k]}"]
    return dc + [image] + cmd


def build_nono_cmd(proj: Path, nono_profile: str | None, network_profile: str | None,
                   allow_domains: list[str], creds: list[str],
                   endpoints: list[tuple[str, str, str]], block_net: bool,
                   cmd: list[str], deny_domains: list[str] | None = None,
                   upstream_proxy: str | None = None,
                   open_ports: list[str] | None = None) -> list[str]:
    """Pure translator: soteria run-flags -> `nono run ... -- <cmd>`.

    Snapshots, argv gate, and ask stay soteria-side (host). Credentials are
    delegated (nono injects via its own proxy — ours stays off to avoid a
    double-proxy conflict). --deny-commands is NOT translated: nono's
    --block-command is startup-only/unenforced; ours still gates at launch.
    """
    nc = ["nono", "run", "--allow", str(proj)]
    if nono_profile:
        nc += ["--profile", nono_profile]
    if network_profile:
        nc += ["--network-profile", network_profile]
    for d in allow_domains or []:
        nc += ["--allow-domain", d]
    for d in deny_domains or []:
        nc += ["--deny-domain", d]
    for c in creds or []:
        nc += ["--credential", c]
    for s, m, g in endpoints or []:
        nc += ["--allow-endpoint", f"{s}:{m}:{g}"]
    if upstream_proxy:
        nc += ["--upstream-proxy", upstream_proxy]
    for p in open_ports or []:
        nc += ["--open-port", str(p)]
    if block_net:
        nc += ["--block-net"]
    return nc + ["--"] + cmd


# --- P18: ghost sessions (detached runs supervised like foreground ones) ---
SESSION_GRACE_DEFAULT = 2.0  # seconds: SIGTERM -> SIGKILL escalation window


def _session_job_path(sid: str) -> Path:
    return SESSIONS / f"{sid}.json"


def _session_spool_path(sid: str) -> Path:
    return SESSIONS / f"{sid}.spool.log"


def session_read(sid: str) -> dict | None:
    """Read one job file. None = unknown/corrupt (fail-closed: never raise)."""
    try:
        return json.loads(_session_job_path(sid).read_text(encoding="utf-8"))
    except Exception:
        return None


def _session_write(job: dict) -> None:
    """Atomic job-file write (tmp + os.replace). Creates sessions dir."""
    SESSIONS.mkdir(parents=True, exist_ok=True)
    p = _session_job_path(job["id"])
    tmp = p.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(job, indent=2), encoding="utf-8")
    os.replace(tmp, p)


def session_alive(job: dict) -> tuple[bool, str]:
    """Liveness via os.kill(pid, 0). Unknown/error = not alive. Never raises."""
    if job.get("status") == "exited" or job.get("exit_code") is not None:
        return False, "marked exited"
    try:
        pid = int(job.get("pid", -1))
    except (TypeError, ValueError):
        return False, "bad pid"
    if pid <= 0:
        return False, "bad pid"
    try:
        os.kill(pid, 0)
        return True, "running"
    except ProcessLookupError:
        return False, "no such process"
    except PermissionError:
        return False, "permission denied (not our process?)"
    except OSError as e:
        return False, f"os error: {e}"


def _session_pid_valid(job: dict) -> tuple[bool, str]:
    """Pid-reuse guard before signalling: re-read job file, probe liveness,
    then check `ps` cmdline contains the job's argv[0] or 'soteria'.
    Any doubt -> (False, reason). Never signals on doubt."""
    job2 = session_read(str(job.get("id", "")))
    if job2 is None:
        return False, "unknown job (file missing/corrupt)"
    try:
        pid = int(job2.get("pid", -1))
    except (TypeError, ValueError):
        return False, "bad pid in job file"
    if pid <= 0:
        return False, "bad pid in job file"
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False, "process already gone"
    except PermissionError:
        return False, "permission denied — refusing to signal a process we cannot inspect"
    except OSError as e:
        return False, f"liveness probe failed: {e}"
    try:
        pr = subprocess.run(["ps", "-o", "args=", "-p", str(pid)],
                            capture_output=True, text=True, timeout=5,
                            stdin=subprocess.DEVNULL)
    except Exception as e:
        return False, f"cannot validate pid (ps failed: {e})"
    if pr.returncode != 0 or not (pr.stdout or "").strip():
        return False, "cannot validate pid (ps knows no such process — refusing)"
    cmdline = pr.stdout.strip()
    try:
        want = os.path.basename(str((job2.get("cmd") or [""])[0]))
    except Exception:
        want = ""
    if want and want not in cmdline and "soteria" not in cmdline:
        return False, f"pid {pid} looks recycled (no {want!r} in cmdline)"
    return True, "ok"


def session_create(cmd: list[str], proj: Path, snapshot_id: str | None,
                   profile: str = "developer", backend: str = "local") -> dict:
    """Write a `running` job file + empty spool. Caller sets the real pid after fork."""
    jid = time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}-{uuid.uuid4().hex[:6]}"
    job = {
        "id": jid,
        "pid": os.getpid(),
        "cmd": list(cmd),
        "project": str(proj),
        "snapshot_id": snapshot_id,
        "started": ts(),
        "started_ts": time.time(),
        "status": "running",
        "exit_code": None,
        "ended": None,
        "spool": str(_session_spool_path(jid)),
        "profile": profile,
        "backend": backend,
    }
    SESSIONS.mkdir(parents=True, exist_ok=True)
    _session_write(job)
    try:
        Path(job["spool"]).write_bytes(b"")
    except OSError:
        pass
    return job


def session_list() -> list[dict]:
    """All jobs, newest first. Dead-but-marked-running rows are flipped to
    exited (persisted best-effort). Never raises."""
    try:
        files = sorted(SESSIONS.glob("*.json"),
                       key=lambda d: d.stat().st_mtime, reverse=True)
    except OSError:
        return []
    out: list[dict] = []
    now = time.time()
    for f in files:
        try:
            job = json.loads(f.read_text(encoding="utf-8"))
        except Exception:
            continue
        alive, reason = session_alive(job)
        job["alive"] = alive
        job["alive_reason"] = reason
        try:
            job["age"] = max(0.0, now - float(job.get("started_ts", now)))
        except (TypeError, ValueError):
            job["age"] = 0.0
        if not alive and job.get("status") == "running" and job.get("exit_code") is None:
            job["status"] = "exited"
            try:
                _session_write({k: v for k, v in job.items()
                                if k not in ("alive", "alive_reason", "age")})
            except OSError:
                pass
        out.append(job)
    return out


def session_stop(sid: str, grace: float = SESSION_GRACE_DEFAULT) -> tuple[int, str]:
    """SIGTERM, escalate to SIGKILL after grace. 0 = stopped/already gone,
    1 = refused/failed. Never signals a pid that fails validation."""
    job = session_read(sid)
    if job is None:
        return 1, f"unknown session {sid}"
    if job.get("status") == "exited" or job.get("exit_code") is not None:
        return 0, f"session {sid} already exited"
    alive, reason = session_alive(job)
    if not alive:
        job["status"] = "exited"
        try:
            _session_write(job)
        except OSError:
            pass
        return 0, f"session {sid} already exited ({reason})"
    ok, why = _session_pid_valid(job)
    if not ok:
        return 1, f"refusing to stop {sid}: {why}"
    pid = int(job["pid"])
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return 0, f"session {sid} already exited"
    except PermissionError:
        return 1, f"cannot stop {sid}: permission denied"
    except OSError as e:
        return 1, f"cannot stop {sid}: {e}"
    audit({"kind": "session_stop", "level": "INFO", "session_id": sid,
           "summary": f"SIGTERM {pid} ({' '.join(job.get('cmd', []))[:120]})"})
    deadline = time.time() + max(0.0, grace)
    while time.time() < deadline:
        alive2, _ = session_alive({**job, "status": "running", "exit_code": None})
        if not alive2:
            break
        time.sleep(0.1)
    else:
        try:
            os.kill(pid, signal.SIGKILL)
            audit({"kind": "session_kill", "level": "INFO", "session_id": sid,
                   "summary": f"SIGKILL {pid} after {grace}s grace"})
        except ProcessLookupError:
            pass
        except OSError as e:
            return 1, f"SIGKILL failed for {sid}: {e}"
    return 0, f"stopped session {sid} (pid {pid})"


def session_attach(sid: str, follow: bool = False) -> int:
    """Dump spool to stdout; follow tails until exit. 0 ok, 2 unknown/unreadable."""
    job = session_read(sid)
    if job is None:
        print(f"unknown session {sid}", file=sys.stderr)
        return 2
    spool = Path(str(job.get("spool") or _session_spool_path(sid)))
    try:
        data = spool.read_bytes()
    except OSError as e:
        print(f"session {sid}: spool unreadable: {e}", file=sys.stderr)
        return 2
    try:
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()
    except OSError:
        pass
    if not follow:
        return 0
    print(f"following session {sid} (Ctrl-C to stop)", file=sys.stderr)
    try:
        pos = len(data)
        while True:
            alive, _ = session_alive(session_read(sid) or {})
            try:
                cur = spool.stat().st_size
            except OSError:
                cur = pos
            if cur > pos:
                try:
                    with open(spool, "rb") as f:
                        f.seek(pos)
                        chunk = f.read()
                    sys.stdout.buffer.write(chunk)
                    sys.stdout.buffer.flush()
                    pos += len(chunk)
                except OSError:
                    pass
            elif cur < pos:
                pos = cur
            if not alive:
                try:
                    with open(spool, "rb") as f:
                        f.seek(pos)
                        tail = f.read()
                    if tail:
                        sys.stdout.buffer.write(tail)
                        sys.stdout.buffer.flush()
                except OSError:
                    pass
                break
            time.sleep(0.4)
    except KeyboardInterrupt:
        pass
    return 0


def cmd_sessions(args) -> int:
    jobs = session_list()
    if not jobs:
        print("(no sessions)")
        return 0
    for j in jobs:
        age = float(j.get("age", 0.0) or 0.0)
        age_s = f"{age:.0f}s" if age < 60 else (f"{age / 60:.0f}m" if age < 3600 else f"{age / 3600:.1f}h")
        state = "alive" if j.get("alive") else "exited"
        print(f"{j.get('id')}  pid={j.get('pid')}  {state}  age={age_s}  exit={j.get('exit_code')}  -- {' '.join(j.get('cmd', []))[:160]}")
    return 0


def cmd_stop(args) -> int:
    rc, msg = session_stop(args.id, grace=float(getattr(args, "grace", SESSION_GRACE_DEFAULT) or 0.0))
    print(msg, file=sys.stderr if rc else sys.stdout)
    return rc


def cmd_attach(args) -> int:
    return session_attach(args.id, follow=bool(getattr(args, "follow", False)))


def cmd_run(args) -> int:
    proj = Path(args.allow or ".").resolve()
    if not proj.is_dir():
        print(f"error: project dir missing: {proj}", file=sys.stderr)
        return 2
    # P0: resolve + validate composable profile (fail closed on invalid)
    try:
        prof_data = load_profile(getattr(args, "profile", "developer") or "developer")
    except Exception as e:
        print(f"soteria: bad profile: {e}", file=sys.stderr)
        return 2
    eff_fs = resolve_effective_fs(prof_data,
                                  [str(proj)], list(getattr(args, "read", []) or []),
                                  list(getattr(args, "write", []) or []),
                                  list(getattr(args, "bypass_protection", []) or []))
    perrs = validate_profile({**prof_data, "filesystem": {**prof_data.get("filesystem", {}),
                              "allow": eff_fs["allow"], "read": eff_fs["read"],
                              "write": eff_fs["write"], "bypass_protection": eff_fs["bypass_protection"]}})
    if perrs:
        print(f"soteria: invalid profile: {'; '.join(perrs)}", file=sys.stderr)
        return 2
    deny = set(DEFAULT_DENY_CMDS)
    if args.deny_commands:
        deny |= {c.strip() for c in args.deny_commands.split(",") if c.strip()}
    allow_cmds = split_csv_flags(list(getattr(args, "allow_command", []) or []))
    if allow_cmds:
        print(f"soteria: --allow-command exempts: {', '.join(sorted({a.lower() for a in allow_cmds}))}",
              file=sys.stderr)
        deny -= {a for a in allow_cmds} | {a.lower() for a in allow_cmds}
    cmd = args.cmd
    if not cmd:
        print("error: nothing to run after --", file=sys.stderr)
        return 2
    sid = snapshot_create(proj) if args.rollback else None
    # P8: explicit --network-profile wins, else profile, else developer
    resolved_net = getattr(args, "network_profile", None) or prof_data.get("network", {}).get("network_profile") or "developer"
    audit({"kind": "session_start", "level": "INFO", "session_id": sid or "no-snap",
           "summary": f"run profile={args.profile} net={resolved_net} -- {' '.join(cmd)}"})
    # P3/P9: tool policy first (deny-only + argv allow-list), then legacy argv gate.
    # --allow-command exempts a tool from mediation entirely.
    eff_commands = effective_tool_commands(
        prof_data.get("command_policies"),
        split_csv_flags([args.deny_commands] if args.deny_commands else []),
        allow_cmds)
    tp = tool_verdict(cmd, {"commands": eff_commands})
    if tp is not None:
        verdict, reason = tp
        kind = "tool.deny"
    else:
        verdict, reason = argv_verdict(cmd, deny, args.ask_mode)
        kind = f"argv.{verdict}"
    audit({"kind": kind, "level": verdict.upper(), "session_id": sid or "no-snap",
           "summary": f"{' '.join(cmd)} — {reason}", "tool": cmd[0]})
    if verdict == "deny":
        print(f"soteria DENY: {reason}", file=sys.stderr)
        return 3
    if verdict == "ask":
        req = {"session_id": sid or "no-snap", "command": cmd, "reason": reason, "cwd": str(proj)}
        if args.ask_socket:
            ok = ask_via_socket(args.ask_socket, req, args.ask_timeout)
            channel = "socket"
        else:
            ok = ask_human(f"soteria ASK ({reason}). allow once?")
            channel = "terminal"
        audit({"kind": f"ask.{'allow' if ok else 'deny'}", "level": "INFO",
               "session_id": sid or "no-snap", "summary": f"{' '.join(cmd)} — {reason} ({channel})"})
        if not ok:
            print(f"soteria: denied ({reason})", file=sys.stderr)
            return 3
    use_docker = args.backend == "docker"
    use_nono = args.backend == "nono"
    if use_docker and not shutil.which("docker"):
        print("soteria: docker CLI not found", file=sys.stderr)
        return 2
    if use_nono and not shutil.which("nono"):
        print("soteria: nono not found (brew install nono)", file=sys.stderr)
        return 2
    if use_docker and args.credential and args.block_net:
        print("soteria: --block-net + --credential conflict on docker (proxy unreachable with --network none)",
              file=sys.stderr)
        return 2
    extra_env: dict[str, str] = {}
    if use_docker:
        for spec in args.env or []:
            if "=" not in spec:
                print(f"soteria: bad --env {spec!r}, want KEY=VAL", file=sys.stderr)
                return 2
            k, v = spec.split("=", 1)
            extra_env[k.strip()] = v
        for var in ("TERM", "NO_COLOR", "LANG", "LC_ALL", "TZ"):
            if var in os.environ:
                extra_env.setdefault(var, os.environ[var])
    # P1: env filtering (allow/deny/set) — nono parity lite
    set_map: dict[str, str] = {}
    for spec in list(getattr(args, "set_env", []) or []):
        if "=" not in spec:
            print(f"soteria: bad --set-env {spec!r}, want KEY=VAL", file=sys.stderr)
            return 2
        k, v = spec.split("=", 1)
        set_map[k.strip()] = v
    env = scrub_env(args.credential or [], list(getattr(args, "allow_env", []) or []),
                    list(getattr(args, "deny_env", []) or []), set_map)
    # P18: ghost sessions — fork before proxy/daemon exist; the child falls
    # through the sandbox assembly below and owns it, the parent exits now.
    dj: dict | None = None
    if getattr(args, "detached", False):
        # Gate already resolved above. Refuse the case it cannot have
        # resolved: ask with no socket channel and no TTY (fail-closed).
        if verdict == "ask" and not getattr(args, "ask_socket", None) and not sys.stdin.isatty():
            print("soteria: detached + needs-approval with no --ask-socket and no TTY — refusing (rc 3). "
                  "Re-run attached, or pass --ask-socket.", file=sys.stderr)
            audit({"kind": "ask.deny", "level": "DENY", "session_id": sid or "no-snap",
                   "summary": f"{' '.join(cmd)} — detached without approval channel"})
            return 3
        if not hasattr(os, "fork"):
            print("soteria: --detached needs os.fork (POSIX); unsupported here", file=sys.stderr)
            return 2
        job = session_create(list(cmd), proj, sid,
                             profile=getattr(args, "profile", "developer") or "developer",
                             backend=getattr(args, "backend", "local") or "local")
        audit({"kind": "session_detached_start", "level": "INFO",
               "session_id": sid or "no-snap",
               "summary": f"detached {job['id']} -- {' '.join(cmd)}"})
        pid = os.fork()
        if pid == 0:
            try:
                os.setsid()
            except OSError:
                pass
            try:
                fd0 = os.open(os.devnull, os.O_RDONLY)
                os.dup2(fd0, 0)
            except OSError:
                pass
            job["pid"] = os.getpid()
            try:
                _session_write(job)
            except OSError:
                pass
            try:
                _spool_fh = open(job["spool"], "ab", buffering=0)
                os.dup2(_spool_fh.fileno(), 1)
                os.dup2(_spool_fh.fileno(), 2)
                try:
                    sys.stdout.reconfigure(write_through=True)
                    sys.stderr.reconfigure(write_through=True)
                except Exception:
                    pass
            except OSError as e:
                audit({"kind": "session_detached_end", "level": "ERROR",
                       "session_id": job["id"], "summary": f"spool open failed: {e}"})
                job.update({"status": "exited", "exit_code": 1, "ended": ts()})
                try:
                    _session_write(job)
                except OSError:
                    pass
                os._exit(1)
            dj = job
            print(f"soteria detached {job['id']}: cwd={proj} snapshot={sid} -- {' '.join(cmd)}", flush=True)
            # fall through: this child owns proxy/shims/daemon/run below
        else:
            job["pid"] = pid
            try:
                _session_write(job)
            except OSError:
                pass
            print(f"detached {job['id']} pid={pid} spool={job['spool']}")
            if sid:
                print(f"snapshot {sid} — `soteria show {sid} --diff` to review, `soteria undo {sid}` to revert")
            return 0
    proxy = None
    rules: list[tuple[str, str, str]] = []
    if args.credential or (use_nono and args.allow_endpoint):
        for spec in args.allow_endpoint or []:
            try:
                svc, method, glob = spec.split(":", 2)
            except ValueError:
                print(f"soteria: bad --allow-endpoint {spec!r}, want Service:METHOD:/glob", file=sys.stderr)
                return 2
            rules.append((svc, method, glob))
    # P2: merge profile network (allow/deny_domain, custom_credentials) with CLI
    prof_net = prof_data.get("network", {}) or {}
    merged_allow = list(dict.fromkeys(list(prof_net.get("allow_domain", []) or []) + list(args.allow_domain or [])))
    merged_deny = list(dict.fromkeys(list(prof_net.get("deny_domain", []) or []) + list(getattr(args, "deny_domain", []) or [])))
    for d in merged_allow:
        if d.lower() in {x.lower() for x in merged_deny}:
            print(f"soteria: domain {d!r} in both allow and deny — deny wins, refusing", file=sys.stderr)
            return 2
        if is_always_denied_host(d.split("/")[-1].split(":")[0] if "://" not in d else urlsplit(d).hostname or d):
            # path-scoped URLs: check host part only
            print(f"soteria: allow-domain {d!r} hits always-denied host", file=sys.stderr)
            return 2
    custom_creds = dict(prof_net.get("custom_credentials", {}) or {})
    # P8: proxy also starts for domain filtering without credentials
    # (CONNECT-only mode). Soft mode can't force traffic in, so warn.
    want_proxy = bool(args.credential or merged_allow or merged_deny)
    if want_proxy and not use_nono and not args.credential and resolve_enforce(args.enforce) == "soft":
        print("soteria: domain filtering without --credential is cooperative in soft mode (HTTP_PROXY only)",
              file=sys.stderr)
    if want_proxy and not use_nono:
        proxy = start_proxy(list(args.credential or []), dict(os.environ), sid or "no-snap", rules,
                            base_host="host.docker.internal" if use_docker else "127.0.0.1",
                            deny_domains=merged_deny, custom_creds=custom_creds,
                            allow_domains=merged_allow, network_profile=resolved_net,
                            proxy_port=getattr(args, "proxy_port", 0) or 0)
        if proxy is None:
            print("soteria: proxy not started (no usable real key and no domain filter) — phantom env only", file=sys.stderr)
        else:
            env.update(proxy.child_env)
    if use_nono and args.credential:
        print("soteria: credentials delegated to nono's proxy (needs key in env or nono keystore)",
              file=sys.stderr)
    # P9: tool shims for local backends — extend deny/argv gates to child
    # processes via a shim dir prepended to PATH. Docker/nono bring
    # their own boundaries, so shims stay local-only.
    shim_dir: str | None = None
    daemon: _Daemon | None = None
    if not use_nono and not use_docker and eff_commands:
        shim_dir = str(HOME / "shims" / (sid or f"run-{os.getpid()}"))
        pol_file = os.path.join(shim_dir, "policy.json")
        try:
            made = build_shims(list(eff_commands), _self_cmd(), Path(shim_dir))
            Path(pol_file).write_text(json.dumps({
                "commands": eff_commands,
                "deny_commands": sorted(deny),
                "ask_mode": args.ask_mode,
                "ask_socket": getattr(args, "ask_socket", None),
                "ask_timeout": getattr(args, "ask_timeout", 120),
            }, indent=2))
            try:
                os.chmod(pol_file, 0o444)
            except OSError:
                pass
            env["PATH"] = shim_dir + os.pathsep + env.get("PATH", "")
            env["SOTERIA_HOME"] = str(HOME)
            env["SOTERIA_SHIM_DIR"] = shim_dir
            env["SOTERIA_BROKER_POLICY"] = pol_file
            env["SOTERIA_SESSION_ID"] = sid or "no-snap"
            if getattr(args, "ask_socket", None):
                env["SOTERIA_ASK_SOCKET"] = args.ask_socket
                env["SOTERIA_ASK_TIMEOUT"] = str(getattr(args, "ask_timeout", 120))
            # P16: supervisor daemon — shims forward here; tools spawn
            # host-side so per-tool Seatbelt scoping can apply (impossible
            # from inside the box). Legacy in-box _broker stays as fallback.
            deny_dirs0, _ = resolve_deny_paths({**prof_data, "filesystem": {
                **prof_data.get("filesystem", {}), "allow": eff_fs["allow"],
                "read": eff_fs["read"], "write": eff_fs["write"],
                "bypass_protection": eff_fs["bypass_protection"]}})
            sock_path = os.path.join(shim_dir, "broker.sock")
            env["SOTERIA_BROKER_SOCK"] = sock_path
            try:
                mem_bytes = parse_size(getattr(args, "memory", "0") or "0")
            except ValueError as e:
                print(f"soteria: bad --memory: {e}", file=sys.stderr)
                return 2
            try:
                nproc_val = int(getattr(args, "max_processes", 0) or 0) or None
                if nproc_val is not None and nproc_val < 0:
                    raise ValueError("negative")
            except (TypeError, ValueError):
                print("soteria: bad --max-processes (want a non-negative int)", file=sys.stderr)
                return 2
            if nproc_val is not None and 0 < nproc_val < 16:
                print(f"soteria: --max-processes {nproc_val} is very low (shells/git/python may starve; 32+ recommended)",
                      file=sys.stderr)
            daemon = _Daemon(sock_path, {
                "commands": eff_commands,
                "deny_commands": sorted(deny),
                "ask_mode": args.ask_mode,
                "ask_socket": getattr(args, "ask_socket", None),
                "ask_timeout": getattr(args, "ask_timeout", 120),
                "tool_timeout": getattr(args, "tool_timeout", DAEMON_TOOL_TIMEOUT_DEFAULT),
                "memory_bytes": mem_bytes,
                "max_processes": nproc_val,
                "proj": str(proj),
                "sid": sid or "no-snap",
                "base_env": dict(env),
                "base_path": env.get("PATH", ""),
                "shim_dir": shim_dir,
                "proxy_port": proxy.port if proxy else None,
                "block_net": bool(args.block_net),
                "deny_paths": deny_dirs0,
                "seatbelt": True,
            })
            daemon.start()
            audit({"kind": "sandbox.shims", "level": "INFO", "session_id": sid or "no-snap",
                   "summary": f"{len(made)} tool shims + supervised broker"})
        except OSError as e:
            print(f"soteria: shim install failed ({e}) — continuing with launch gate only",
                  file=sys.stderr)
            shim_dir = None
            daemon = None
    if shim_dir and not use_docker and not use_nono and cmd \
            and "/" not in cmd[0] and cmd[0] in eff_commands:
        # The launch gate already decided THIS invocation (incl. any ask
        # approval); run the real binary directly so the broker doesn't
        # re-gate it. Applies prewrap so kernel/docker/nono command
        # assembly is unaffected. Shims keep guarding descendants.
        real0 = resolve_real_binary(cmd[0], shim_dir, env.get("PATH", ""))
        if real0 is not None:
            cmd = [real0] + cmd[1:]
    if use_nono:
        mode = "nono"  # nono is the kernel boundary; ours stays supervisor (snapshot, gate, ask, audit)
        if args.deny_commands:
            print("soteria: --deny-commands enforced at launch gate only under --backend nono "
                  "(shims are local-only; nono has its own tool sandbox)", file=sys.stderr)
        cmd = build_nono_cmd(proj, args.nono_profile, resolved_net, merged_allow,
                             list(args.credential or []), rules, args.block_net, cmd,
                             deny_domains=merged_deny,
                             upstream_proxy=getattr(args, "upstream_proxy", None),
                             open_ports=list(getattr(args, "open_port", []) or []))
        audit({"kind": "sandbox.nono", "level": "INFO", "session_id": sid or "no-snap",
               "summary": f"nono run <- {proj}"})
    elif use_docker:
        mode = "soft"  # container is the boundary; Seatbelt stays off the host client
        if args.enforce == "kernel":
            print("soteria: --enforce kernel ignored with --backend docker (container enforces fs isolation)",
                  file=sys.stderr)
        if not _docker_available():
            print("soteria: docker daemon unreachable (start Docker Desktop?)", file=sys.stderr)
            return 2
        container_env = dict(proxy.child_env) if proxy else {}
        for c in args.credential or []:
            var = CRED_ENV_VARS.get(c.lower())
            if var:
                container_env.setdefault(var, f"soteria_phantom_{c.lower()}")
        container_env.update(extra_env)
        cmd = build_docker_cmd(proj, args.image, container_env, cmd, args.block_net, args.container_user)
        audit({"kind": "sandbox.docker", "level": "INFO", "session_id": sid or "no-snap",
               "summary": f"docker {args.image}:/workspace <- {proj}" +
                          (" net blocked" if args.block_net else
                           (" net via host proxy" if proxy else " net open (no container firewall yet)"))})
    else:
        if args.block_net and resolve_enforce(args.enforce) == "soft":
            print("soteria: --block-net needs kernel mode; soft mode leaves network open", file=sys.stderr)
        mode = resolve_enforce(args.enforce)
        if args.enforce == "kernel" and mode != "kernel":
            if os.environ.get("SOTERIA_BOXED"):
                print("soteria: nested box — kernel unavailable, degrading to soft (argv + audit still apply)",
                      file=sys.stderr)
            elif sys.platform.startswith("linux"):
                info = linux_landlock_info()
                print(f"soteria: no native Landlock yet ({info['summary']}) — "
                      "use --backend nono (kernel) or --backend docker (container) on Linux",
                      file=sys.stderr)
                return 2
            else:
                print("soteria: kernel enforcement unavailable (need macOS + sandbox-exec)", file=sys.stderr)
                return 2
        if mode == "kernel":
            extra_writes = [e for e in (eff_fs.get("allow", []) + eff_fs.get("write", []))
                            if e and e != str(proj) and os.path.exists(os.path.expanduser(e))]
            deny_dirs, _deny_files = resolve_deny_paths({**prof_data, "filesystem": {
                **prof_data.get("filesystem", {}), "allow": eff_fs["allow"],
                "read": eff_fs["read"], "write": eff_fs["write"],
                "bypass_protection": eff_fs["bypass_protection"]}})
            sb_profile = write_sb_profile(proj, sid, args.profile, extra_writes,
                                          proxy.port if proxy else None, args.block_net,
                                          deny_paths=deny_dirs or None,
                                          shim_dir=shim_dir)
            cmd = ["sandbox-exec", "-f", str(sb_profile)] + cmd
            audit({"kind": "sandbox.kernel", "level": "INFO", "session_id": sid or "no-snap",
                   "summary": f"seatbelt {sb_profile.name} writes boxed to {proj}" +
                              (" net pinned to proxy" if proxy else (" net blocked" if args.block_net else " net open"))})
    if use_docker:
        box, net_label = "docker", ("container+proxy" if proxy else
                                    ("container-blocked" if args.block_net else "container-open"))
    elif use_nono:
        box, net_label = "nono", (resolved_net or "default") + ("+block-net" if args.block_net else "")
    else:
        box = mode
        net_label = ('proxy-pinned' if proxy and mode == 'kernel' else
                     ('blocked' if args.block_net and mode == 'kernel' else resolved_net))
    print(f"soteria {box}-box: cwd={proj} net={net_label} snapshot={sid}", flush=True)
    try:
        p = subprocess.run(cmd, cwd=str(proj), env=env)
        rc = p.returncode
    except FileNotFoundError:
        print(f"soteria: binary not found: {cmd[0]}", file=sys.stderr)
        if dj is not None:
            audit({"kind": "session_end", "level": "INFO", "session_id": sid or "no-snap",
                   "summary": f"exit=127 files_changed=n/a (detached {dj['id']})"})
            audit({"kind": "session_detached_end", "level": "INFO", "session_id": dj["id"],
                   "summary": "detached exit=127 (binary not found)"})
            dj.update({"status": "exited", "exit_code": 127, "ended": ts()})
            try:
                _session_write(dj)
            except OSError:
                pass
            os._exit(127)
        return 127
    finally:
        if proxy is not None:
            proxy.shutdown()
        if daemon is not None:
            daemon.stop()
    audit({"kind": "session_end", "level": "INFO", "session_id": sid or "no-snap",
           "summary": f"exit={rc} files_changed={sum(len(v) for v in snapshot_diff(proj, sid).values()) if sid else 'n/a'}" + (f" (detached {dj['id']})" if dj is not None else "")})
    if dj is not None:
        audit({"kind": "session_detached_end", "level": "INFO", "session_id": dj["id"],
               "summary": f"detached exit={rc}"})
        dj.update({"status": "exited", "exit_code": int(rc), "ended": ts()})
        try:
            _session_write(dj)
        except OSError:
            pass
        try:
            sys.stdout.flush()
            sys.stderr.flush()
        except OSError:
            pass
        os._exit(int(rc))
    if sid:
        print(f"snapshot {sid} — `soteria show {sid} --diff` to review, `soteria undo {sid}` to revert")
    return rc


def cmd_list(args) -> int:
    if not SNAPS.exists():
        print("(no snapshots)")
        return 0
    entries = sorted(
        (d for d in SNAPS.iterdir() if (d / "manifest.json").exists()),
        key=lambda d: d.stat().st_mtime, reverse=True,  # newest first: head -1 is latest
    )
    for d in entries:
        try:
            m = json.loads((d / "manifest.json").read_text())
            print(f"{d.name}  {m['created']}  {m['project']}")
        except OSError:
            continue
    return 0


def cmd_show(args) -> int:
    sid = args.id
    dest = SNAPS / sid
    if not (dest / "manifest.json").exists():
        print(f"unknown snapshot {sid}", file=sys.stderr)
        return 2
    proj = Path((dest / "project.txt").read_text().strip())
    d = snapshot_diff(proj, sid)
    print(f"snapshot {sid} project={proj}")
    for k in ("added", "modified", "deleted"):
        print(f"{k} ({len(d[k])}):")
        for r in d[k][:50]:
            print(f"  {r}")
    if args.diff:
        for rel in d["modified"][:20]:
            old = (dest / "tree" / rel).read_text(errors="replace").splitlines()
            try:
                new = (proj / rel).read_text(errors="replace").splitlines()
            except OSError:
                continue
            for line in difflib.unified_diff(old, new, f"a/{rel}", f"b/{rel}", lineterm=""):
                print(line)
    return 0


def cmd_undo(args) -> int:
    sid = args.id
    dest = SNAPS / sid
    if not (dest / "manifest.json").exists():
        print(f"unknown snapshot {sid}", file=sys.stderr)
        return 2
    proj = Path((dest / "project.txt").read_text().strip())
    d = snapshot_diff(proj, sid)
    n = sum(len(v) for v in d.values())
    print(f"will revert {n} files in {proj} to snapshot {sid}")
    if not args.yes and not ask_human("confirm undo?"):
        print("aborted")
        return 1
    snapshot_restore(proj, sid)
    audit({"kind": "undo", "level": "INFO", "session_id": sid, "summary": f"restored {n} files"})
    print(f"restored {n} files")
    return 0


def cmd_logs(args) -> int:
    if getattr(args, "verify", False):
        ok, msg = audit_verify()
        print(("OK: " if ok else "FAIL: ") + msg)
        return 0 if ok else 1
    if args.follow:
        print(f"following {RECORDS} (Ctrl-C to stop)")
        try:
            with open(RECORDS, encoding="utf-8") as f:
                f.seek(0, os.SEEK_END)
                while True:
                    line = f.readline()
                    if line:
                        print(line, end="")
                    else:
                        time.sleep(0.4)
        except FileNotFoundError:
            print("(no records yet)")
        except KeyboardInterrupt:
            pass
        return 0
    try:
        lines = RECORDS.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        print("(no records yet)")
        return 0
    filt = (args.filter or "").lower()
    out = [l for l in lines if filt in l.lower()][-args.limit:]
    print("\n".join(out))
    return 0


def _read_events() -> list[dict]:
    try:
        raw = RECORDS.read_text(encoding="utf-8").splitlines() if RECORDS.exists() else []
    except OSError:
        return []
    out = []
    for line in raw:
        if not line.strip():
            continue
        try:
            out.append(json.loads(line))
        except Exception:
            continue
    return out


def _parse_ts(e: dict) -> float:
    try:
        return datetime.strptime(e.get("ts", ""), "%Y-%m-%dT%H:%M:%SZ").replace(
            tzinfo=timezone.utc).timestamp()
    except Exception:
        return 0.0


def scan_findings(events: list[dict], only_session: str | None = None,
                  burst_n: int = 50, burst_secs: int = 60,
                  persist_n: int = 3) -> list[dict]:
    """Post-hoc sequence rules over the audit log (Phase 2 lite).

    Rules: exfil-sequence (denied secret-path read then egress in one
    session), burst anomaly, metadata probing, denied-command persistence.
    Pure function — easy to unit-test, no live enforcement (yet).
    """
    by_sess: dict[str, list[dict]] = {}
    for e in events:
        sid = str(e.get("session_id", "?"))
        if only_session and sid != only_session:
            continue
        by_sess.setdefault(sid, []).append(e)
    findings: list[dict] = []
    for sid, evs in by_sess.items():
        if sid in ("?", "no-snap"):
            continue
        gatedenies = [e for e in evs if str(e.get("kind", "")).endswith(".deny")
                      and "secret path" in str(e.get("summary", ""))]
        egress = [e for e in evs if e.get("kind") in ("proxy.allow", "proxy.connect_allow")]
        if gatedenies and egress:
            t_deny = min(_parse_ts(e) for e in gatedenies)
            t_egr = [_parse_ts(e) for e in egress]
            if any(t >= t_deny for t in t_egr):
                findings.append({"rule": "exfil-sequence", "severity": "high",
                                 "session_id": sid,
                                 "summary": f"{len(gatedenies)} denied secret-path read(s) before {len(egress)} egress event(s)"})
        tools = [e for e in evs if str(e.get("kind", "")).startswith(("broker.", "tool.", "argv."))]
        if len(tools) >= burst_n:
            ts = sorted(_parse_ts(e) for e in tools)
            for i in range(len(ts) - burst_n + 1):
                if ts[i + burst_n - 1] - ts[i] <= burst_secs:
                    findings.append({"rule": "burst", "severity": "medium",
                                     "session_id": sid,
                                     "summary": f"{burst_n}+ gated tool events in {burst_secs}s"})
                    break
        meta = [e for e in evs if "metadata" in str(e.get("summary", "")).lower()
                or "denied_cidr" in str(e.get("summary", ""))]
        if len(meta) >= persist_n:
            findings.append({"rule": "metadata-probing", "severity": "medium",
                             "session_id": sid,
                             "summary": f"{len(meta)} metadata/link-local attempts"})
        per_tool: dict[str, int] = {}
        for e in evs:
            if str(e.get("kind", "")).endswith(".deny") and e.get("tool"):
                per_tool[str(e["tool"])] = per_tool.get(str(e["tool"]), 0) + 1
        for tool, n in sorted(per_tool.items()):
            if n >= persist_n:
                findings.append({"rule": "denied-persistence", "severity": "low",
                                 "session_id": sid,
                                 "summary": f"'{tool}' denied {n}x (agent pushing the guardrail)"})
    return findings


def cmd_scan(args) -> int:
    events = _read_events()
    if not events:
        print("(no records yet)")
        return 0
    findings = scan_findings(events, getattr(args, "session", None) or None)
    if getattr(args, "json", False):
        print(json.dumps(findings, indent=2))
    else:
        if not findings:
            print(f"scan: clean ({len(events)} events, no findings)")
        for f in findings:
            print(f"[{f['severity'].upper()}] {f['rule']} session={f['session_id']} — {f['summary']}")
        high = sum(1 for f in findings if f["severity"] == "high")
        print(f"scan: {len(findings)} finding(s), {high} high")
    fail_on = getattr(args, "fail_on", "never") or "never"
    if fail_on != "never":
        order = {"low": 0, "medium": 1, "high": 2}
        if any(order.get(f["severity"], 0) >= order.get(fail_on, 99) for f in findings):
            return 1
    return 0


def cmd_timeline(args) -> int:
    events = _read_events()
    sid = getattr(args, "id", None)
    if sid:
        events = [e for e in events if str(e.get("session_id", "")) == sid]
    events.sort(key=lambda e: (_parse_ts(e), int(e.get("seq", 0) or 0)))
    limit = getattr(args, "limit", 100) or 100
    for e in events[-limit:]:
        print(f"{e.get('ts', '?')} {e.get('kind', '?'):22} {e.get('summary', '')[:160]}")
    if not events:
        print("(no events)")
    return 0


def _self_cmd() -> list[str]:
    # Absolute paths: shims re-enter soteria from any child cwd, so a
    # relative argv[0] (e.g. './soteria') would break broker re-entry.
    if getattr(sys, "frozen", False):  # PyInstaller bundle: exe takes args directly
        return [os.path.abspath(sys.executable)]
    script = sys.argv[0]
    if not os.path.dirname(script):
        script = shutil.which(script) or script
    return [sys.executable, os.path.abspath(script)]


def cmd_verify(args) -> int:
    sid = args.id
    dest = SNAPS / sid
    if not (dest / "manifest.json").exists():
        print(f"unknown snapshot {sid}", file=sys.stderr)
        return 2
    try:
        proj = Path((dest / "project.txt").read_text().strip())
    except OSError:
        proj = Path(".")
    ok, msg = snapshot_verify(proj, sid)
    print(("OK: " if ok else "FAIL: ") + f"{sid} — {msg}")
    return 0 if ok else 1


def cmd_cleanup(args) -> int:
    keep = getattr(args, "keep", 10) or 10
    older_than = getattr(args, "older_than", None)
    dry = getattr(args, "dry_run", False)
    now = time.time()
    # P18: prune exited ghost sessions (never running+alive ones). Runs even
    # when no snapshots exist.
    try:
        _sess_jobs = session_list()
    except Exception:
        _sess_jobs = []
    _sess_dead = [j for j in _sess_jobs if not (j.get("status") == "running" and j.get("alive"))]
    _sess_running_n = len(_sess_jobs) - len(_sess_dead)
    _sess_victims = []
    for i, j in enumerate(sorted(_sess_dead, key=lambda x: float(x.get("started_ts", 0.0) or 0.0), reverse=True)):
        if i >= keep:
            _sess_victims.append(j)
            continue
        if older_than is not None:
            try:
                if (now - float(j.get("started_ts", now))) > float(older_than) * 86400:
                    _sess_victims.append(j)
            except (TypeError, ValueError):
                continue
    for j in _sess_victims:
        print(("would remove sessions/" if dry else "removing sessions/") + str(j.get("id")))
        if not dry:
            for p in (_session_job_path(str(j.get("id"))), Path(str(j.get("spool", "")))):
                try:
                    if p.is_file() or p.is_symlink():
                        p.unlink()
                except OSError as e:
                    print(f"  error: {e}", file=sys.stderr)
            audit({"kind": "cleanup", "level": "INFO", "session_id": str(j.get("id")),
                   "summary": f"pruned session {j.get('id')}"})
    if _sess_running_n and not dry:
        print(f"cleanup: keeping {_sess_running_n} running session(s)")
    if not SNAPS.exists():
        print("(no snapshots)")
        return 0
    entries = sorted(
        (d for d in SNAPS.iterdir() if (d / "manifest.json").exists()),
        key=lambda d: d.stat().st_mtime, reverse=True,
    )
    victims: list[Path] = []
    for i, d in enumerate(entries):
        if i >= keep:
            victims.append(d)
            continue
        if older_than is not None:
            try:
                if (now - d.stat().st_mtime) > float(older_than) * 86400:
                    victims.append(d)
            except OSError:
                continue
    if not victims:
        print(f"cleanup: nothing to remove (keeping {min(keep, len(entries))}/{len(entries)})")
        return 0
    for d in victims:
        print(("would remove " if dry else "removing ") + d.name)
        if not dry:
            try:
                shutil.rmtree(d)
                audit({"kind": "cleanup", "level": "INFO", "session_id": d.name,
                       "summary": f"pruned snapshot {d.name}"})
            except OSError as e:
                print(f"  error: {e}", file=sys.stderr)
    # P9: prune orphaned per-run shim dirs (same keep/age rules, by dirname).
    shims = HOME / "shims"
    if shims.is_dir():
        pruned_names = {d.name for d in victims}
        age_limit = float(older_than) * 86400 if older_than is not None else 7 * 86400
        for s in shims.iterdir():
            try:
                stale = s.name in pruned_names or (now - s.stat().st_mtime) > age_limit
            except OSError:
                continue
            if stale:
                print(("would remove shims/" if dry else "removing shims/") + s.name)
                if not dry:
                    try:
                        shutil.rmtree(s)
                    except OSError as e:
                        print(f"  error: {e}", file=sys.stderr)
    return 0


def _run_cli(home: Path, *argv, env_extra: dict | None = None):
    env = dict(os.environ)
    env["SOTERIA_HOME"] = str(home)
    if env_extra:
        env.update(env_extra)
    return subprocess.run(
        [*_self_cmd(), *argv],
        env=env, capture_output=True, text=True, timeout=60,
        stdin=subprocess.DEVNULL,  # never let a child prompt hang the suite
    )


