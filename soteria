def expand_profile_vars(s: str) -> str:
    if not isinstance(s, str):
        return s
    if s.startswith("~/"):
        return str(Path.home() / s[2:])
    if "$WORKDIR" in s:
        s = s.replace("$WORKDIR", os.environ.get("SOTERIA_WORKDIR", str(Path.cwd())))
    return os.path.expandvars(s)


def _deep_merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for k, v in (over or {}).items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = _deep_merge(out[k], v)
        elif isinstance(v, list) and isinstance(out.get(k), list):
            out[k] = out[k] + [x for x in v if x not in out[k]]
        else:
            out[k] = v
    return out


def validate_profile(p: dict) -> list[str]:
    errs: list[str] = []
    if not isinstance(p, dict):
        return ["profile must be an object"]
    fs = p.get("filesystem", {})
    for k in ("allow", "read", "write", "deny", "bypass_protection", "allow_files"):
        if k in fs and not isinstance(fs[k], list):
            errs.append(f"filesystem.{k} must be a list")
    net = p.get("network", {})
    for k in ("allow_domain", "deny_domain", "credentials"):
        if k in net and not isinstance(net[k], list):
            errs.append(f"network.{k} must be a list")
    # bypass requires a matching grant (nono rule)
    bypass = set(fs.get("bypass_protection", []) or [])
    grants = set((fs.get("allow", []) or []) + (fs.get("read", []) or []) + (fs.get("write", []) or []))
    for b in bypass:
        if b not in grants:
            errs.append(f"bypass_protection {b!r} needs a matching allow/read/write grant")
    cp = p.get("command_policies", {})
    cmds = (cp.get("commands", {}) or {}) if isinstance(cp, dict) else {}
    if not isinstance(cmds, dict):
        errs.append("command_policies.commands must be an object")
    else:
        for tool, pol in cmds.items():
            if not isinstance(pol, dict):
                errs.append(f"command_policies.commands.{tool} must be an object")
                continue
            sb = pol.get("sandbox")
            if sb is not None:
                if not isinstance(sb, dict):
                    errs.append(f"command_policies.commands.{tool}.sandbox must be an object")
                else:
                    for k in ("fs_read", "fs_write"):
                        if k in sb and not isinstance(sb[k], list):
                            errs.append(f"command_policies.commands.{tool}.sandbox.{k} must be a list")
                    for k in set(sb) - {"fs_read", "fs_write"}:
                        errs.append(f"command_policies.commands.{tool}.sandbox.{k} unknown (want fs_read/fs_write)")
    return errs


def load_profile(name_or_path: str | None) -> dict:
    """Resolve preset name, ./path.json, user config, or bundled profiles/ with extends."""
    if not name_or_path or name_or_path == "developer":
        base = PROFILE_PRESETS["developer"]
        return json.loads(json.dumps(base))
    cand = Path(str(name_or_path))
    data: dict | None = None
    user_dir = _config_dir() / "profiles"
    if cand.exists() and cand.is_file():
        data = json.loads(cand.read_text())
    elif (user_dir / f"{name_or_path}.json").exists():
        data = json.loads((user_dir / f"{name_or_path}.json").read_text())
    elif (PROFILES_DIR / f"{name_or_path}.json").exists() and PROFILES_DIR != user_dir:
        data = json.loads((PROFILES_DIR / f"{name_or_path}.json").read_text())
    elif (_resource_dir("profiles") / f"{name_or_path}.json").exists():
        data = json.loads((_resource_dir("profiles") / f"{name_or_path}.json").read_text())
    elif name_or_path in PROFILE_PRESETS:
        return json.loads(json.dumps(PROFILE_PRESETS[name_or_path]))
    else:
        raise FileNotFoundError(f"unknown profile {name_or_path!r}")
    # resolve extends chain (one level + preset)
    extends = data.get("extends")
    if extends:
        parent = load_profile(extends)
        data = _deep_merge(parent, {k: v for k, v in data.items() if k != "extends"})
    return data


def resolve_effective_fs(profile: dict, cli_allow: list[str], cli_read: list[str],
                         cli_write: list[str], cli_bypass: list[str]) -> dict:
    fs = {k: list(v) for k, v in (profile.get("filesystem", {}) or {}).items() if isinstance(v, list)}
    for k in ("allow", "read", "write", "bypass_protection"):
        fs.setdefault(k, [])
    fs["allow"] += [x for x in (cli_allow or []) if x not in fs["allow"]]
    fs["read"] += [x for x in (cli_read or []) if x not in fs["read"]]
    fs["write"] += [x for x in (cli_write or []) if x not in fs["write"]]
    fs["bypass_protection"] += [x for x in (cli_bypass or []) if x not in fs["bypass_protection"]]
    # expand groups include -> read hints (deny groups enforced via Seatbelt denies)
    return fs


def resolve_deny_paths(profile: dict) -> tuple[list[str], list[str]]:
    """Return (deny_dirs, deny_files) from groups + profile, minus bypass_protection."""
    deny_dirs: list[str] = []
    deny_files: list[str] = []
    for g in (profile.get("groups", {}) or {}).get("include", []) or []:
        gd = GROUP_DEFS.get(g, {})
        deny_dirs += list(gd.get("deny", []) or [])
        deny_files += list(gd.get("deny_files", []) or [])
    fs = profile.get("filesystem", {}) or {}
    deny_dirs += list(fs.get("deny", []) or [])
    bypass = set(fs.get("bypass_protection", []) or [])
    deny_dirs = [d for d in deny_dirs if d not in bypass]
    # de-dup preserve order
    seen: set[str] = set()
    out: list[str] = []
    for d in deny_dirs:
        if d not in seen:
            seen.add(d)
            out.append(d)
    return out, [f for f in deny_files if f not in bypass]


def env_match(name: str, patterns: list[str]) -> bool:
    for pat in patterns or []:
        if pat == "*" or pat == name:
            return True
        if pat.endswith("_*") and name.startswith(pat[:-1]):
            return True
        if pat.endswith("*") and not pat.startswith("*") and name.startswith(pat[:-1]):
            return True
        try:
            import fnmatch as _fn
            if _fn.fnmatch(name, pat):
                return True
        except Exception:
            continue
    return False


