def ts() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _redact_summary(s: str) -> str:
    # best-effort: strip Bearer/token values, URL userinfo, ?sig= secrets
    import re as _re
    s = _re.sub(r"(Bearer\s+)[A-Za-z0-9_\-\.~\+/]+=*\b", r"\1[redacted]", s)
    s = _re.sub(r"(?i)(api[_-]?key\s*[:=]\s*)\S+", r"\1[redacted]", s)
    s = _re.sub(r"(?i)(--token\s+)(\S+)", r"\1[redacted]", s)
    s = _re.sub(r"(sig|signature)=[^&\s]+", r"\1=[redacted]", s)
    return s


def _audit_prev() -> tuple[int, str]:
    try:
        if not RECORDS.exists() or RECORDS.stat().st_size == 0:
            return 0, "GENESIS"
        with open(RECORDS, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            step = min(size, 65536)
            f.seek(size - step)
            tail = f.read().decode("utf-8", "replace").strip().splitlines()
            for line in reversed(tail):
                try:
                    o = json.loads(line)
                    return int(o.get("seq", 0)), str(o.get("hash", "GENESIS"))
                except Exception:
                    continue
    except OSError:
        pass
    return 0, "GENESIS"


def audit(obj: dict) -> None:
    try:
        HOME.mkdir(parents=True, exist_ok=True)
    except FileExistsError:
        pass  # concurrent mkdir race (proxy threads); dir exists, carry on
    obj.setdefault("ts", ts())
    obj.setdefault("service", "soteria")
    if isinstance(obj.get("summary"), str):
        obj["summary"] = _redact_summary(obj["summary"])[:2000]
    seq, prev = _audit_prev()
    obj["seq"] = seq + 1
    obj["prev"] = prev
    payload = json.dumps({k: v for k, v in obj.items() if k != "hash"}, sort_keys=True)
    obj["hash"] = hashlib.sha256((prev + "|" + payload).encode()).hexdigest()
    with open(RECORDS, "a", encoding="utf-8") as f:
        f.write(json.dumps(obj) + "\n")


def audit_verify() -> tuple[bool, str]:
    try:
        lines = RECORDS.read_text(encoding="utf-8").splitlines() if RECORDS.exists() else []
    except OSError as e:
        return False, f"read error: {e}"
    # backward compat: pre-chain legacy lines (no seq/hash) are skipped; chain starts at first chained event
    chained = []
    for line in lines:
        if not line.strip():
            continue
        try:
            o = json.loads(line)
        except Exception:
            return False, "bad json"
        if "seq" not in o or "hash" not in o:
            continue
        chained.append((line, o))
    prev = "GENESIS"
    expect = 1
    # seq may not start at 1 if legacy prefix exists — anchor to first chained seq's prev==GENESIS or continuity
    for line, o in chained:
        # allow first chained event to start chain regardless of absolute seq (legacy prefix)
        if o.get("prev") != prev:
            # if this is the first chained event and its prev is GENESIS, anchor here
            if prev == "GENESIS" and o.get("prev") == "GENESIS":
                pass
            else:
                return False, f"seq {o.get('seq')}: chain break"
        payload = json.dumps({k: v for k, v in o.items() if k != "hash"}, sort_keys=True)
        want = hashlib.sha256((o["prev"] + "|" + payload).encode()).hexdigest()
        if o.get("hash") != want:
            return False, f"seq {o.get('seq')}: hash mismatch (tamper?)"
        prev = o["hash"]
        expect += 1
    n_legacy = len(lines) - len(chained)
    suffix = f" (+{n_legacy} legacy pre-chain skipped)" if n_legacy else ""
    return True, f"{len(chained)} events verified, head {prev[:12]}{suffix}"


def snapshot_verify(proj: Path, sid: str) -> tuple[bool, str]:
    dest = SNAPS / sid
    try:
        manifest = json.loads((dest / "manifest.json").read_text())["files"]
    except OSError as e:
        return False, f"manifest missing: {e}"
    bad: list[str] = []
    for rel, want in manifest.items():
        p = dest / "tree" / rel
        if not p.is_file():
            bad.append(f"missing:{rel}")
            continue
        try:
            if sha256_file(p) != want:
                bad.append(f"mismatch:{rel}")
        except OSError:
            bad.append(f"unreadable:{rel}")
        if len(bad) >= 5:
            break
    if bad:
        return False, f"{len(bad)} problems: {', '.join(bad)}"
    return True, f"{len(manifest)} objects verified"


def sha256_file(p: Path) -> str:
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def iter_project_files(root: Path):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in EXCLUDE and not d.startswith(".soteria")]
        for fn in filenames:
            p = Path(dirpath) / fn
            try:
                if p.is_symlink() or not p.is_file():
                    continue
                yield p.relative_to(root)
            except OSError:
                continue


def snapshot_create(proj: Path) -> str:
    sid = time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}"
    dest = SNAPS / sid
    dest.mkdir(parents=True, exist_ok=True)
    manifest: dict[str, str] = {}
    for rel in iter_project_files(proj):
        src = proj / rel
        try:
            manifest[str(rel)] = sha256_file(src)
            d = dest / "tree" / rel
            d.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, d)
        except OSError:
            continue
    (dest / "manifest.json").write_text(json.dumps({"id": sid, "project": str(proj), "created": ts(), "files": manifest}, indent=2))
    (dest / "project.txt").write_text(str(proj))
    return sid


def snapshot_diff(proj: Path, sid: str) -> dict:
    dest = SNAPS / sid
    manifest = json.loads((dest / "manifest.json").read_text())["files"]
    current: dict[str, str] = {}
    for rel in iter_project_files(proj):
        try:
            current[str(rel)] = sha256_file(proj / rel)
        except OSError:
            continue
    old, new = set(manifest), set(current)
    return {
        "added": sorted(new - old),
        "deleted": sorted(old - new),
        "modified": sorted(r for r in old & new if manifest[r] != current[r]),
    }


def snapshot_restore(proj: Path, sid: str) -> dict:
    dest = SNAPS / sid / "tree"
    d = snapshot_diff(proj, sid)
    for rel in d["added"]:
        try:
            (proj / rel).unlink()
        except OSError:
            pass
    for rel in d["modified"] + d["deleted"]:
        src = dest / rel
        dst = proj / rel
        if src.exists():
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
        elif dst.exists():
            try:
                dst.unlink()
            except OSError:
                pass
    return d


def argv_verdict(cmd: list[str], deny_cmds: set[str], ask_mode: str) -> tuple[str, str]:
    blob = " ".join(cmd)
    if not cmd:
        return "deny", "empty command"
    if cmd[0] in deny_cmds:
        return "deny", f"command '{cmd[0]}' in deny list"
    # P3: direct-exec bypass — /bin/rm, /usr/bin/sudo etc map to denied base name
    base = os.path.basename(cmd[0]) if "/" in cmd[0] else None
    if base and base in deny_cmds:
        return "deny", f"direct-exec bypass of denied '{base}' via {cmd[0]}"
    for m in SECRET_PATH_MARKS:
        if m in blob:
            return "deny", f"secret path pattern '{m}'"
    for m in METADATA_MARKS:
        if m in blob:
            return "deny", "cloud metadata destination"
    if ask_mode != "never":
        for marks in IRREVERSIBLE_MARKS:
            if all(tok in cmd for tok in marks):
                if ask_mode == "strict" or marks in ([["git", "push"]] if ask_mode == "escalations" else [marks]):
                    return "ask", f"irreversible pattern '{' '.join(marks)}'"
                if ask_mode == "strict":
                    return "ask", "strict mode: confirm new action class"
    return "allow", "ok"


